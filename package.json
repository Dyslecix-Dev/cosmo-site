{
  "name": "cosmo-site",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "lefthook install || true",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "check:links": "docker run --rm -v $(pwd)/dist:/root/dist lycheeverse/lychee --root-dir /root/dist --exclude opengraph.xyz /root/dist",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^6.3.1",
    "astro-og-canvas": "^0.11.1",
    "astro-pagefind": "^1.8.6",
    "astro-seo": "^1.1.0",
    "canvaskit-wasm": "^0.41.1",
    "motion": "^12.38.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "2.4.14",
    "@tailwindcss/typography": "^0.5.19",
    "lefthook": "^2.1.6",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  }
}
