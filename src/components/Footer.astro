---

<footer class="footer relative isolate border-t border-brand-primary/15 dark:border-brand-quaternary/15 bg-brand-primary text-brand-quaternary dark:bg-brand-quaternary dark:text-brand-primary">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div class="footer-aurora"></div>
    <div class="footer-grid"></div>
  </div>

  <div class="mx-auto w-full max-w-6xl px-6 sm:px-10 py-14">
    <div class="grid grid-cols-2 gap-10 sm:gap-12 sm:grid-cols-12">
      <div class="col-span-2 sm:col-span-5">
        <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.2em] opacity-70">
          <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-full bg-brand-tertiary shadow-[0_0_10px_currentColor]"></span>
          <span>Transmission</span>
        </div>
        <p class="mt-5 font-heading text-2xl sm:text-3xl font-bold leading-tight tracking-tight">
          Light Speed Development
        </p>
        <p class="mt-4 max-w-md text-sm opacity-75 leading-relaxed">
          Easy, fast, and mission-ready
        </p>
        <div class="footer-snippet mt-6 flex max-w-full items-center gap-3 rounded-lg border border-current/20 bg-brand-quaternary/10 dark:bg-brand-primary/10 pl-4 pr-2 py-1.5 font-mono text-xs sm:text-sm backdrop-blur-md">
          <span aria-hidden="true" class="text-brand-tertiary shrink-0">$</span>
          <code data-footer-copy-text class="footer-snippet-code overflow-x-auto whitespace-nowrap py-1">pnpm create astro@latest -- --template DyslecixDev/cosmo</code>
          <button
            type="button"
            data-footer-copy-btn
            aria-label="Copy install command"
            class="footer-copy group inline-flex shrink-0 items-center justify-center rounded-md p-1.5 transition duration-200 hover:bg-current/10 hover:text-brand-tertiary"
          >
            <svg data-footer-copy-icon="default" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <svg data-footer-copy-icon="done" class="hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          </button>
        </div>
      </div>

      <nav class="sm:col-span-3" aria-label="Footer">
        <h2 class="font-mono text-xs uppercase tracking-[0.2em] opacity-70">Navigate</h2>
        <ul class="mt-5 space-y-3 text-sm">
          <li><a class="footer-link" href="/">Home</a></li>
          <li><a class="footer-link" href="/docs">Docs</a></li>
          <li><a class="footer-link" href="/blueprint">Blueprint</a></li>
          <li><a class="footer-link" href="/roadmap">Roadmap</a></li>
          <li><a class="footer-link" href="/privacy">Privacy</a></li>
        </ul>
      </nav>

      <div class="sm:col-span-4">
        <h2 class="font-mono text-xs uppercase tracking-[0.2em] opacity-70">Signals</h2>
        <ul class="mt-5 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
                class="footer-social group relative inline-flex h-11 w-11 items-center justify-center rounded-full border border-current/20 bg-brand-quaternary/10 dark:bg-brand-primary/10 backdrop-blur-md transition duration-300 hover:-translate-y-1 hover:border-brand-tertiary/60"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="currentColor"
                  aria-hidden="true"
                  class="transition group-hover:text-brand-tertiary"
                >
                  <path d={s.path} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-6 hidden max-w-xs text-xs opacity-70 leading-relaxed sm:block">
          Cookieless analytics and no session replay.<br/>We respect your personal space.
        </p>
      </div>

      <p class="col-span-2 text-xs opacity-70 leading-relaxed sm:hidden">
        Cookieless analytics and no session replay.<br/>We respect your personal space.
      </p>
    </div>

    <div class="mt-12 flex flex-col gap-3 pt-6 sm:flex-row sm:items-center sm:justify-between text-xs font-mono uppercase tracking-[0.18em] opacity-75">
      <span>&copy; {year} Cosmo</span>
      <span class="inline-flex items-center gap-2">
        <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-full bg-brand-tertiary shadow-[0_0_10px_currentColor]"></span>
        Built with Astro
      </span>
    </div>
  </div>
</footer>

<style>
  .footer-aurora {
    position: absolute;
    bottom: -30%;
    left: 50%;
    width: 70vw;
    height: 70vw;
    transform: translateX(-50%);
    border-radius: 9999px;
    filter: blur(120px) saturate(140%);
    opacity: 0.22;
    background: radial-gradient(circle, var(--color-brand-tertiary) 0%, transparent 65%);
  }

  .footer-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in oklch, currentColor 6%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklch, currentColor 6%, transparent) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at center bottom, black 30%, transparent 75%);
  }

  .footer-link {
    color: inherit;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    padding-bottom: 2px;
    transition: color 200ms ease, background-size 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .footer-link:hover {
    color: var(--color-brand-tertiary);
    background-size: 100% 1px;
  }

  .footer-snippet-code {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--color-brand-tertiary) 70%, transparent) transparent;
  }

  .footer-snippet-code::-webkit-scrollbar {
    height: 6px;
  }

  .footer-snippet-code::-webkit-scrollbar-track {
    background: transparent;
  }

  .footer-snippet-code::-webkit-scrollbar-thumb {
    background: color-mix(in oklch, var(--color-brand-tertiary) 55%, transparent);
    border-radius: 9999px;
  }

  .footer-snippet-code::-webkit-scrollbar-thumb:hover {
    background: var(--color-brand-tertiary);
  }

  .footer-social:hover {
    box-shadow:
      0 14px 32px -10px color-mix(in oklch, var(--color-brand-tertiary) 80%, transparent),
      0 0 0 1px color-mix(in oklch, var(--color-brand-tertiary) 35%, transparent),
      inset 0 0 18px -6px color-mix(in oklch, var(--color-brand-tertiary) 50%, transparent);
  }
</style>

<script>
  function initFooterCopy() {
    const btn = document.querySelector<HTMLButtonElement>("[data-footer-copy-btn]");
    const codeEl = document.querySelector<HTMLElement>("[data-footer-copy-text]");
    if (!btn || !codeEl) return;
    if (btn.dataset.bound === "1") return;
    btn.dataset.bound = "1";

    const iconDefault = btn.querySelector<SVGElement>('[data-footer-copy-icon="default"]');
    const iconDone = btn.querySelector<SVGElement>('[data-footer-copy-icon="done"]');

    btn.addEventListener("click", async () => {
      const text = codeEl.textContent?.trim() ?? "";
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }
      iconDefault?.classList.add("hidden");
      iconDone?.classList.remove("hidden");
      btn.setAttribute("aria-label", "Copied");
      window.setTimeout(() => {
        iconDone?.classList.add("hidden");
        iconDefault?.classList.remove("hidden");
        btn.setAttribute("aria-label", "Copy install command");
      }, 1600);
    });
  }

  initFooterCopy();
  document.addEventListener("astro:page-load", initFooterCopy);
</script>
