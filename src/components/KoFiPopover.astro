---
const DELAY_MS = 0;
---

<div
  id="kofi-popover"
  role="dialog"
  aria-label="Support Cosmo"
  aria-live="polite"
  class="kofi-popover pointer-events-none fixed bottom-0 right-0 left-0 z-50 opacity-0 translate-y-4 pb-6 sm:pb-0 sm:bottom-6 sm:right-6 sm:left-auto sm:w-72"
>
  <div class="relative rounded-2xl border border-brand-primary/15 dark:border-brand-quaternary/15 bg-brand-quaternary dark:bg-brand-primary shadow-[0_8px_40px_-12px_rgba(0,0,0,0.35)] p-5">
    <button
      type="button"
      id="kofi-dismiss"
      aria-label="Dismiss"
      class="absolute top-3 right-3 rounded-md p-1 text-brand-primary/40 dark:text-brand-quaternary/40 hover:text-brand-primary dark:hover:text-brand-quaternary transition"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>

    <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-brand-secondary dark:text-brand-tertiary">[ Fuel the mission ]</p>

    <p class="mt-2 text-sm leading-relaxed text-brand-primary/80 dark:text-brand-quaternary/80">
      If Cosmo saves you time, consider buying me a coffee.
    </p>

    <a
      href="https://ko-fi.com/dyslecixdev"
      target="_blank"
      rel="noopener noreferrer"
      class="kofi-btn mt-4 inline-flex w-full items-center justify-center gap-2.5 rounded-xl bg-brand-primary dark:bg-brand-quaternary px-4 py-2.5 text-sm font-semibold text-brand-quaternary dark:text-brand-primary transition hover:opacity-85"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.034-3.954-.709-.965-1.041-2.7-.091-3.71.951-1.01 3.005-1.086 4.363.407 0 0 1.565-1.782 3.468-.963 1.904.82 1.832 3.011.723 4.311zm6.173.478c-.928.116-1.682.028-1.682.028V7.284h1.77s1.971.551 1.971 2.638c0 1.913-.985 2.667-2.059 3.015z" />
      </svg>
      Buy me a coffee
    </a>
  </div>
</div>

<style>
  .kofi-popover {
    transition: opacity 400ms cubic-bezier(0.22, 1, 0.36, 1), transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .kofi-popover.is-visible {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0);
  }
  .kofi-popover.is-hiding {
    pointer-events: none;
    opacity: 0;
    transform: translateY(8px);
  }

  @media (prefers-reduced-motion: reduce) {
    .kofi-popover {
      transition: opacity 200ms ease;
      transform: translateY(0) !important;
    }
  }
</style>

<script is:inline define:vars={{ DELAY_MS }}>
  function initKoFiPopover() {
    const popover = document.getElementById("kofi-popover");
    const dismiss = document.getElementById("kofi-dismiss");
    if (!popover || !dismiss) return;

    if (sessionStorage.getItem("kofi-dismissed") === "1") return;

    const show = () => {
      popover.classList.add("is-visible");
    };

    const hide = () => {
      popover.classList.add("is-hiding");
      popover.classList.remove("is-visible");
      sessionStorage.setItem("kofi-dismissed", "1");
    };

    const timer = setTimeout(show, DELAY_MS);

    dismiss.addEventListener("click", hide);

    return () => {
      clearTimeout(timer);
      dismiss.removeEventListener("click", hide);
    };
  }

  initKoFiPopover();
  document.addEventListener("astro:page-load", initKoFiPopover);
</script>
