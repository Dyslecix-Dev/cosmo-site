---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import iconDark from "@/assets/icon-dark.png";
import iconLight from "@/assets/icon-light.png";
import MobileMenu from "@/components/navbar/MobileMenu.astro";
import MotionToggle from "@/components/navbar/MotionToggle.astro";
import NavDropdown from "@/components/navbar/NavDropdown.astro";
import ThemeToggle from "@/components/navbar/ThemeToggle.astro";

const { pathname } = Astro.url;

const docs = (await getCollection("docs")).filter((entry) => !entry.data.draft);
const sortedDocs = [...docs].sort((a, b) => {
  const aHas = a.data.order !== undefined;
  const bHas = b.data.order !== undefined;
  if (aHas && bHas) return (a.data.order as number) - (b.data.order as number);
  if (aHas) return -1;
  if (bHas) return 1;
  return a.data.title.localeCompare(b.data.title);
});

const isHomeActive = pathname === "/";
const isDocsActive = pathname.startsWith("/docs");
---

<header class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-6 pt-4">
  <nav
    class="mx-auto flex max-w-3xl items-center justify-between gap-2 rounded-full border border-brand-primary/15 dark:border-brand-quaternary/15 bg-brand-quaternary/30 dark:bg-brand-primary/20 backdrop-blur-lg px-2 py-2 shadow-[0_8px_30px_rgba(0,0,0,0.06)]"
    aria-label="Primary"
  >
    <a href="/" class="flex shrink-0 items-center gap-2 pl-3 pr-2" aria-label="Cosmo home">
      <Image src={iconLight} alt="" class="h-7 w-7 block dark:hidden" />
      <Image src={iconDark} alt="" class="h-7 w-7 hidden dark:block" />
      <span class="font-heading text-sm font-bold tracking-tight">Cosmo</span>
    </a>

    <ul class="hidden sm:flex relative items-center gap-1" data-nav-pill>
      <span
        aria-hidden="true"
        data-pill-indicator
        class="absolute inset-y-1 z-0 rounded-full bg-brand-primary/8 dark:bg-brand-quaternary/8 opacity-0 pointer-events-none transition-opacity duration-200"
      ></span>

      <li class="relative z-10">
        <a
          href="/"
          data-nav-item
          aria-current={isHomeActive ? "page" : undefined}
          class:list={[
            "block rounded-full px-4 py-2 text-sm font-medium transition",
            isHomeActive
              ? "text-brand-primary dark:text-brand-quaternary"
              : "text-brand-primary/70 dark:text-brand-quaternary/70 hover:text-brand-primary dark:hover:text-brand-quaternary",
          ]}
        >
          Home
        </a>
      </li>

      <NavDropdown docs={sortedDocs} pathname={pathname} isActive={isDocsActive} />

      <li class="relative z-10">
        <a
          href="https://github.com/Dyslecix-Dev/cosmo"
          target="_blank"
          rel="noopener"
          data-nav-item
          class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium text-brand-primary/70 dark:text-brand-quaternary/70 hover:text-brand-primary dark:hover:text-brand-quaternary transition"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1-.02-1.96-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.97.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.45.11-3.03 0 0 .97-.31 3.18 1.18a11.04 11.04 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.58.23 2.74.11 3.03.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .31.21.68.8.56C20.21 21.39 23.5 17.07 23.5 12 23.5 5.65 18.35.5 12 .5Z"></path>
          </svg>
          GitHub
        </a>
      </li>
    </ul>

    <div>
      <ThemeToggle variant="icon" />
      <MotionToggle variant="icon" />
    </div>

    <MobileMenu docs={sortedDocs} pathname={pathname} isHomeActive={isHomeActive} />
  </nav>
</header>

<script>
  import { animate } from "motion";

  function initPillIndicator() {
    const container = document.querySelector<HTMLElement>("[data-nav-pill]");
    const indicator = document.querySelector<HTMLElement>("[data-pill-indicator]");
    if (!container || !indicator) return;

    const items = Array.from(container.querySelectorAll<HTMLElement>("[data-nav-item]"));
    const activeItem = items.find((el) => el.getAttribute("aria-current") === "page") ?? null;

    const moveTo = (target: HTMLElement | null, immediate = false) => {
      if (!target) {
        animate(indicator, { opacity: 0 }, { duration: 0.15 });
        return;
      }
      const containerRect = container.getBoundingClientRect();
      const rect = target.getBoundingClientRect();
      const x = rect.left - containerRect.left;
      const width = rect.width;
      if (immediate) {
        indicator.style.transform = `translateX(${x}px)`;
        indicator.style.width = `${width}px`;
        indicator.style.opacity = "1";
      } else {
        animate(
          indicator,
          { transform: `translateX(${x}px)`, width: `${width}px`, opacity: 1 },
          { duration: 0.35, ease: [0.22, 1, 0.36, 1] },
        );
      }
    };

    if (activeItem) moveTo(activeItem, true);

    for (const item of items) {
      item.addEventListener("pointerenter", () => moveTo(item));
      item.addEventListener("focus", () => moveTo(item));
    }

    container.addEventListener("pointerleave", () => moveTo(activeItem));
  }

  initPillIndicator();
  document.addEventListener("astro:page-load", initPillIndicator);
</script>
