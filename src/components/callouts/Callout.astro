---
type Props = {
  type?: "note" | "tip" | "warning" | "danger";
  title?: string;
};

const { type = "note", title } = Astro.props;

const styles: Record<NonNullable<Props["type"]>, { container: string; label: string; defaultTitle: string }> = {
  note: {
    container: "callout-note",
    label: "callout-label-note",
    defaultTitle: "Note",
  },
  tip: {
    container: "callout-tip",
    label: "callout-label-tip",
    defaultTitle: "Tip",
  },
  warning: {
    container: "callout-warning",
    label: "callout-label-warning",
    defaultTitle: "Warning",
  },
  danger: {
    container: "callout-danger",
    label: "callout-label-danger",
    defaultTitle: "Danger",
  },
};

const s = styles[type];
const heading = title ?? s.defaultTitle;
---

<aside class:list={["callout not-prose my-6 border-l-4 rounded-r-md px-4 py-3", s.container]} role="note" aria-label={heading}>
  <p class:list={["font-semibold text-sm uppercase tracking-wide mb-1", s.label]}>{heading}</p>
  <div class="text-sm leading-relaxed [&>p]:my-1">
    <slot />
  </div>
</aside>

