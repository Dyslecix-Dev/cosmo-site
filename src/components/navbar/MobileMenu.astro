---
import type { CollectionEntry } from "astro:content";
import ThemeToggle from "@/components/navbar/ThemeToggle.astro";

interface Props {
  docs: CollectionEntry<"docs">[];
  pathname: string;
  isHomeActive: boolean;
}

const { docs, pathname, isHomeActive } = Astro.props;
---

<button
  type="button"
  aria-label="Open menu"
  aria-expanded="false"
  data-mobile-toggle
  class="sm:hidden inline-flex shrink-0 items-center justify-center rounded-full h-10 w-10 text-brand-primary dark:text-brand-quaternary"
>
  <svg data-icon="open" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
    <path d="M4 8h16M4 16h16" stroke-linecap="round"></path>
  </svg>
  <svg data-icon="close" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 hidden">
    <path d="M6 6l12 12M6 18L18 6" stroke-linecap="round"></path>
  </svg>
</button>

<div
  id="mobile-overlay"
  data-mobile-overlay
  aria-hidden="true"
  class="fixed inset-0 z-40 bg-brand-quaternary dark:bg-brand-primary opacity-0 pointer-events-none transition-opacity duration-300 sm:hidden"
>
  <div class="flex h-full flex-col justify-between px-6 pt-28 pb-12">
    <nav aria-label="Mobile">
      <ul class="space-y-1">
        <li>
          <a
            href="/"
            data-mobile-link
            aria-current={isHomeActive ? "page" : undefined}
            class="group flex items-baseline justify-between border-b border-brand-primary/10 dark:border-brand-quaternary/10 py-5 font-heading text-3xl font-bold tracking-tight"
          >
            <span>Home</span>
            <span aria-hidden="true" class="font-mono text-xs text-brand-secondary dark:text-brand-tertiary">01</span>
          </a>
        </li>
        <li>
          <div class="border-b border-brand-primary/10 dark:border-brand-quaternary/10 py-5">
            <a
              href="/docs"
              data-mobile-link
              aria-current={pathname === "/docs" || pathname === "/docs/" ? "page" : undefined}
              class="flex items-baseline justify-between"
            >
              <span class="font-heading text-3xl font-bold tracking-tight">Docs</span>
              <span aria-hidden="true" class="font-mono text-xs text-brand-secondary dark:text-brand-tertiary">02</span>
            </a>
            <ul class="mt-3 space-y-1.5">
              {
                docs.map((doc) => {
                  const href = `/docs/${doc.id}`;
                  const isCurrent = pathname === href || pathname === `${href}/`;
                  return (
                    <li>
                      <a
                        href={href}
                        data-mobile-link
                        aria-current={isCurrent ? "page" : undefined}
                        class:list={[
                          "block py-1.5 text-sm transition",
                          isCurrent
                            ? "font-medium text-brand-primary dark:text-brand-quaternary"
                            : "text-brand-secondary dark:text-brand-tertiary hover:text-brand-primary dark:hover:text-brand-quaternary",
                        ]}
                      >
                        {doc.data.title}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </div>
        </li>
        <li>
          <a
            href="https://github.com/Dyslecix-Dev/cosmo"
            target="_blank"
            rel="noopener"
            data-mobile-link
            class="flex items-baseline justify-between border-b border-brand-primary/10 dark:border-brand-quaternary/10 py-5 font-heading text-3xl font-bold tracking-tight"
          >
            <span>GitHub</span>
            <span aria-hidden="true" class="font-mono text-xs text-brand-secondary dark:text-brand-tertiary">03</span>
          </a>
        </li>
      </ul>
    </nav>

    <ThemeToggle variant="pill" />
  </div>
</div>

<script>
  function initMobileMenu() {
    const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
    const overlay = document.querySelector<HTMLElement>("[data-mobile-overlay]");
    if (!toggle || !overlay) return;

    const setOverlay = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      overlay.setAttribute("aria-hidden", String(!open));
      const openIcon = toggle.querySelector<SVGElement>('[data-icon="open"]');
      const closeIcon = toggle.querySelector<SVGElement>('[data-icon="close"]');
      openIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
      if (open) {
        overlay.classList.remove("pointer-events-none");
        overlay.style.opacity = "1";
        document.body.style.overflow = "hidden";
      } else {
        overlay.style.opacity = "0";
        overlay.classList.add("pointer-events-none");
        document.body.style.overflow = "";
      }
    };

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      setOverlay(!isOpen);
    });

    for (const link of overlay.querySelectorAll<HTMLAnchorElement>("[data-mobile-link]")) {
      link.addEventListener("click", () => setOverlay(false));
    }

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOverlay(false);
      }
    });
  }

  initMobileMenu();
  document.addEventListener("astro:page-load", initMobileMenu);
</script>
