---
import type { CollectionEntry } from "astro:content";
import MotionToggle from "@/components/navbar/MotionToggle.astro";
import ThemeToggle from "@/components/navbar/ThemeToggle.astro";

interface Props {
  docs: CollectionEntry<"docs">[];
  pathname: string;
  isHomeActive: boolean;
}

const { docs, pathname, isHomeActive } = Astro.props;
const isDocsIndexActive = pathname === "/docs" || pathname === "/docs/";

const aboutLinks = [
  { href: "/built-with-cosmo", label: "Built with Cosmo" },
  { href: "/roadmap", label: "Roadmap" },
];
---

<div class="sm:hidden relative" data-mobile-menu>
  <button
    type="button"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="mobile-menu-panel"
    data-mobile-toggle
    class="inline-flex shrink-0 items-center justify-center rounded-full h-10 w-10 text-brand-primary dark:text-brand-quaternary"
  >
    <svg data-icon="open" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
      <path d="M4 8h16M4 16h16" stroke-linecap="round"></path>
    </svg>
    <svg data-icon="close" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 hidden">
      <path d="M6 6l12 12M6 18L18 6" stroke-linecap="round"></path>
    </svg>
  </button>

  <div
    id="mobile-menu-panel"
    data-mobile-panel
    class="fixed left-4 right-4 top-20 z-40 max-h-[calc(100dvh-7rem)] overflow-y-auto overscroll-contain origin-top rounded-2xl border border-brand-primary/15 dark:border-brand-quaternary/15 bg-brand-quaternary/99 dark:bg-brand-primary/99 backdrop-blur-lg shadow-[0_20px_60px_rgba(0,0,0,0.25)] opacity-0 -translate-y-2 scale-95 pointer-events-none transition duration-200 ease-out data-[open=true]:opacity-100 data-[open=true]:translate-y-0 data-[open=true]:scale-100 data-[open=true]:pointer-events-auto"
  >
    <div class="p-3">
      <a
        href="/"
        data-mobile-link
        aria-current={isHomeActive ? "page" : undefined}
        class:list={[
          "flex items-center justify-between rounded-xl px-3 py-3 text-sm transition",
          isHomeActive
            ? "bg-brand-primary/10 dark:bg-brand-quaternary/10 font-medium text-brand-primary dark:text-brand-quaternary"
            : "text-brand-primary dark:text-brand-quaternary hover:bg-brand-primary/5 dark:hover:bg-brand-quaternary/5",
        ]}
      >
        <span class="font-medium">Home</span>
        <span aria-hidden="true" class="font-mono text-[0.65rem] text-brand-secondary dark:text-brand-tertiary">01</span>
      </a>

      <div class="mx-3 my-2 h-px bg-brand-primary/10 dark:bg-brand-quaternary/10"></div>

      <a
        href="/docs"
        data-mobile-link
        aria-current={isDocsIndexActive ? "page" : undefined}
        class:list={[
          "flex items-center justify-between rounded-xl px-3 py-3 text-sm transition",
          isDocsIndexActive
            ? "bg-brand-primary/10 dark:bg-brand-quaternary/10 font-medium text-brand-primary dark:text-brand-quaternary"
            : "text-brand-primary dark:text-brand-quaternary hover:bg-brand-primary/5 dark:hover:bg-brand-quaternary/5",
        ]}
      >
        <span class="font-medium">All guides</span>
        <span aria-hidden="true" class="font-mono text-[0.65rem] text-brand-secondary dark:text-brand-tertiary">02</span>
      </a>

      <ul class="mt-1 space-y-0.5 pl-3">
        {
          docs.map((doc, i) => {
            const href = `/docs/${doc.id}`;
            const isCurrent = pathname === href || pathname === `${href}/`;
            return (
              <li>
                <a
                  href={href}
                  data-mobile-link
                  aria-current={isCurrent ? "page" : undefined}
                  class:list={[
                    "flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition",
                    isCurrent
                      ? "bg-brand-primary/8 dark:bg-brand-quaternary/8 font-medium text-brand-primary dark:text-brand-quaternary"
                      : "text-brand-primary/80 dark:text-brand-quaternary/80 hover:bg-brand-primary/5 dark:hover:bg-brand-quaternary/5",
                  ]}
                >
                  <span class="font-mono text-[0.65rem] text-brand-secondary dark:text-brand-tertiary tabular-nums">0{i + 1}</span>
                  <span class="flex-1">{doc.data.title}</span>
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="mx-3 my-2 h-px bg-brand-primary/10 dark:bg-brand-quaternary/10"></div>

      <div
        class:list={[
          "flex items-center justify-between rounded-xl px-3 py-3 text-sm transition text-brand-primary dark:text-brand-quaternary hover:bg-brand-primary/5 dark:hover:bg-brand-quaternary/5"
        ]}
      >
        <span class="font-medium">About</span>
        <span aria-hidden="true" class="font-mono text-[0.65rem] text-brand-secondary dark:text-brand-tertiary">03</span>
      </div>

      <ul class="mt-1 space-y-0.5 pl-3">
        {
          aboutLinks.map((link, i) => {
            const isCurrent = pathname === link.href || pathname === `${link.href}/`;
            return (
              <li>
                <a
                  href={link.href}
                  data-mobile-link
                  aria-current={isCurrent ? "page" : undefined}
                  class:list={[
                    "flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition",
                    isCurrent
                      ? "bg-brand-primary/8 dark:bg-brand-quaternary/8 font-medium text-brand-primary dark:text-brand-quaternary"
                      : "text-brand-primary/85 dark:text-brand-quaternary/85 hover:bg-brand-primary/5 dark:hover:bg-brand-quaternary/5",
                  ]}
                >
                  <span class="font-mono text-[0.65rem] text-brand-secondary dark:text-brand-tertiary tabular-nums">0{i + 1}</span>
                  <span class="flex-1">{link.label}</span>
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="flex flex-col gap-2 px-1 pt-4 pb-1">
        <ThemeToggle variant="pill" />
        <MotionToggle variant="pill" />
      </div>
    </div>
  </div>
</div>

<script>
  function setOpen(root: Element, open: boolean) {
    const toggle = root.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
    const panel = root.querySelector<HTMLElement>("[data-mobile-panel]");
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", String(open));
    panel.dataset.open = String(open);
    const openIcon = toggle.querySelector<SVGElement>('[data-icon="open"]');
    const closeIcon = toggle.querySelector<SVGElement>('[data-icon="close"]');
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  }

  let controller: AbortController | null = null;

  function initMobileMenu() {
    controller?.abort();
    const root = document.querySelector<HTMLElement>("[data-mobile-menu]");
    if (!root) return;
    const toggle = root.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
    if (!toggle) return;

    controller = new AbortController();
    const { signal } = controller;

    let pointerAt = 0;
    toggle.addEventListener(
      "pointerdown",
      () => {
        pointerAt = Date.now();
      },
      { signal },
    );

    toggle.addEventListener(
      "click",
      (event) => {
        event.stopPropagation();
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        setOpen(root, !isOpen);
      },
      { signal },
    );

    // Open on keyboard focus so tabbing into the navbar reveals the menu
    // contents (which would otherwise stay invisible but remain in the tab
    // order). Skip pointer-induced focus — the click handler toggles.
    root.addEventListener(
      "focusin",
      () => {
        if (Date.now() - pointerAt < 400) return;
        if (toggle.getAttribute("aria-expanded") !== "true") setOpen(root, true);
      },
      { signal },
    );

    root.addEventListener(
      "focusout",
      (event) => {
        const next = (event as FocusEvent).relatedTarget as Node | null;
        if (!next || !root.contains(next)) setOpen(root, false);
      },
      { signal },
    );

    for (const link of root.querySelectorAll<HTMLAnchorElement>("[data-mobile-link]")) {
      link.addEventListener("click", () => setOpen(root, false), { signal });
    }

    document.addEventListener(
      "click",
      (event) => {
        const target = event.target as Element | null;
        if (!target) return;
        if (!target.closest("[data-mobile-menu]")) setOpen(root, false);
      },
      { signal },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
          setOpen(root, false);
          toggle.focus();
        }
      },
      { signal },
    );
  }

  initMobileMenu();
  document.addEventListener("astro:page-load", initMobileMenu);
</script>
