---
import type { CollectionEntry } from "astro:content";
import MotionToggle from "@/components/navbar/MotionToggle.astro";
import ThemeToggle from "@/components/navbar/ThemeToggle.astro";

interface Props {
  docs: CollectionEntry<"docs">[];
  pathname: string;
  isHomeActive: boolean;
}

const { docs, pathname, isHomeActive } = Astro.props;
const isDocsIndexActive = pathname === "/docs" || pathname === "/docs/";

const aboutLinks = [
  { href: "/blueprint", label: "Blueprint" },
  { href: "/roadmap", label: "Roadmap" },
];
---

<div class="sm:hidden relative" data-mobile-menu>
  <button
    type="button"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="mobile-menu-panel"
    data-mobile-toggle
    class="inline-flex shrink-0 items-center justify-center rounded-full h-10 w-10 text-brand-primary dark:text-brand-quaternary"
  >
    <svg data-icon="open" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
      <path d="M4 8h16M4 16h16" stroke-linecap="round"></path>
    </svg>
    <svg data-icon="close" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 hidden">
      <path d="M6 6l12 12M6 18L18 6" stroke-linecap="round"></path>
    </svg>
  </button>

  <div
    id="mobile-menu-panel"
    data-mobile-panel
    class="fixed left-4 right-4 top-20 z-40 max-h-[calc(100dvh-7rem)] overflow-y-auto overscroll-contain origin-top rounded-2xl border border-brand-primary/15 dark:border-brand-quaternary/15 bg-brand-quaternary/99 dark:bg-brand-primary/99 backdrop-blur-lg shadow-[0_20px_60px_rgba(0,0,0,0.25)] opacity-0 -translate-y-2 scale-95 pointer-events-none transition duration-200 ease-out data-[open=true]:opacity-100 data-[open=true]:translate-y-0 data-[open=true]:scale-100 data-[open=true]:pointer-events-auto"
  >
    <div class="p-3">
      <a
        href="/"
        data-mobile-link
        aria-current={isHomeActive ? "page" : undefined}
        class:list={[
          "flex items-center justify-between rounded-xl px-3 py-3 text-sm transition",
          isHomeActive
            ? "bg-brand-primary/10 dark:bg-brand-quaternary/10 font-medium text-brand-primary dark:text-brand-quaternary"
            : "text-brand-primary dark:text-brand-quaternary hover:bg-brand-primary/5 dark:hover:bg-brand-quaternary/5",
        ]}
      >
        <span class="font-medium">Home</span>
        <span class="font-mono text-[0.7rem] text-brand-secondary dark:text-brand-tertiary">&#9733;</span>
      </a>

      <div class="mx-3 my-2 h-px bg-brand-primary/10 dark:bg-brand-quaternary/10"></div>

      <a
        href="/docs"
        data-mobile-link
        aria-current={isDocsIndexActive ? "page" : undefined}
        class:list={[
          "flex items-center justify-between rounded-xl px-3 py-3 text-sm transition",
          isDocsIndexActive
            ? "bg-brand-primary/10 dark:bg-brand-quaternary/10 font-medium text-brand-primary dark:text-brand-quaternary"
            : "text-brand-primary dark:text-brand-quaternary hover:bg-brand-primary/5 dark:hover:bg-brand-quaternary/5",
        ]}
      >
        <span class="font-medium">All guides</span>
        <span class="font-mono text-[0.7rem] text-brand-secondary dark:text-brand-tertiary">&#9733;</span>
      </a>

      <ul class="mt-1 space-y-0.5 pl-3">
        {
          docs.map((doc, i) => {
            const href = `/docs/${doc.id}`;
            const isCurrent = pathname === href || pathname === `${href}/`;
            return (
              <li>
                <a
                  href={href}
                  data-mobile-link
                  aria-current={isCurrent ? "page" : undefined}
                  class:list={[
                    "flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition",
                    isCurrent
                      ? "bg-brand-primary/8 dark:bg-brand-quaternary/8 font-medium text-brand-primary dark:text-brand-quaternary"
                      : "text-brand-primary/80 dark:text-brand-quaternary/80 hover:bg-brand-primary/5 dark:hover:bg-brand-quaternary/5",
                  ]}
                >
                  <span class="font-mono text-[0.65rem] text-brand-secondary dark:text-brand-tertiary tabular-nums">0{i + 1}</span>
                  <span class="flex-1">{doc.data.title}</span>
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="mx-3 my-2 h-px bg-brand-primary/10 dark:bg-brand-quaternary/10"></div>

      <div
        class:list={[
          "flex items-center justify-between rounded-xl px-3 py-3 text-sm transition text-brand-primary dark:text-brand-quaternary hover:bg-brand-primary/5 dark:hover:bg-brand-quaternary/5"
        ]}
      >
        <span class="font-medium">About</span>
        <span class="font-mono text-[0.7rem] text-brand-secondary dark:text-brand-tertiary">&#9733;</span>
      </div>

      <ul class="mt-1 space-y-0.5 pl-3">
        {
          aboutLinks.map((link, _) => {
            const isCurrent = pathname === link.href || pathname === `${link.href}/`;
            return (
              <li>
                <a
                  href={link.href}
                  data-mobile-link
                  aria-current={isCurrent ? "page" : undefined}
                  class:list={[
                    "flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition",
                    isCurrent
                      ? "bg-brand-primary/8 dark:bg-brand-quaternary/8 font-medium text-brand-primary dark:text-brand-quaternary"
                      : "text-brand-primary/85 dark:text-brand-quaternary/85 hover:bg-brand-primary/5 dark:hover:bg-brand-quaternary/5",
                  ]}
                >
                  <span class="font-mono text-[0.7rem] text-brand-secondary dark:text-brand-tertiary">&#9733;</span>
                  <span class="flex-1">{link.label}</span>
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="mx-3 my-2 h-px bg-brand-primary/10 dark:bg-brand-quaternary/10"></div>

      <div class="px-1">
        <div class="flex items-center gap-3 rounded-full border border-brand-primary/20 dark:border-brand-quaternary/20 px-4 py-3">
          <svg aria-hidden="true" viewBox="0 0 15 15" fill="currentColor" class="h-4 w-4 shrink-0 text-brand-primary/50 dark:text-brand-quaternary/50">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M10 6.5C10 8.433 8.433 10 6.5 10C4.567 10 3 8.433 3 6.5C3 4.567 4.567 3 6.5 3C8.433 3 10 4.567 10 6.5ZM9.30884 10.0159C8.53901 10.6318 7.56251 11 6.5 11C4.01472 11 2 8.98528 2 6.5C2 4.01472 4.01472 2 6.5 2C8.98528 2 11 4.01472 11 6.5C11 7.56251 10.6318 8.53901 10.0159 9.30884L12.8536 12.1464C13.0488 12.3417 13.0488 12.6583 12.8536 12.8536C12.6583 13.0488 12.3417 13.0488 12.1464 12.8536L9.30884 10.0159Z" />
          </svg>
          <input
            id="mobile-search-input"
            data-mobile-search-input
            type="search"
            placeholder="Search docs…"
            autocomplete="off"
            spellcheck="false"
            aria-label="Search"
            aria-controls="mobile-search-results"
            aria-autocomplete="list"
            class="flex-1 bg-transparent text-sm text-brand-primary dark:text-brand-quaternary placeholder:text-brand-primary/40 dark:placeholder:text-brand-quaternary/40 outline-none min-w-0"
          />
          <button
            type="button"
            aria-label="Clear search"
            data-mobile-search-clear
            class="hidden shrink-0 items-center justify-center rounded-full h-6 w-6 text-brand-primary/50 dark:text-brand-quaternary/50 hover:bg-brand-primary/8 dark:hover:bg-brand-quaternary/8 transition"
          >
            <svg aria-hidden="true" viewBox="0 0 15 15" fill="currentColor" class="h-3.5 w-3.5">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M11.7816 4.03157C12.0062 3.80702 12.0062 3.44295 11.7816 3.2184C11.5571 2.99385 11.193 2.99385 10.9685 3.2184L7.50005 6.68682L4.03164 3.2184C3.80708 2.99385 3.44301 2.99385 3.21846 3.2184C2.99391 3.44295 2.99391 3.80702 3.21846 4.03157L6.68688 7.49999L3.21846 10.9684C2.99391 11.193 2.99391 11.557 3.21846 11.7816C3.44301 12.0061 3.80708 12.0061 4.03164 11.7816L7.50005 8.31316L10.9685 11.7816C11.193 12.0061 11.5571 12.0061 11.7816 11.7816C12.0062 11.557 12.0062 11.193 11.7816 10.9684L8.31322 7.49999L11.7816 4.03157Z" />
            </svg>
          </button>
        </div>
        <div
          id="mobile-search-results"
          data-mobile-search-results
          role="listbox"
          aria-label="Search results"
          class="mt-1 max-h-48 overflow-y-auto overscroll-contain"
        >
          <p data-mobile-search-empty class="hidden px-2 py-4 text-center text-sm text-brand-primary/50 dark:text-brand-quaternary/50">
            No results found.
          </p>
        </div>
      </div>

      <div class="flex flex-col gap-2 px-1 pt-2 pb-1">
        <ThemeToggle variant="pill" />
        <MotionToggle variant="pill" />
      </div>
    </div>
  </div>
</div>

<script>
  function setOpen(root: Element, open: boolean) {
    const toggle = root.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
    const panel = root.querySelector<HTMLElement>("[data-mobile-panel]");
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", String(open));
    panel.dataset.open = String(open);
    const openIcon = toggle.querySelector<SVGElement>('[data-icon="open"]');
    const closeIcon = toggle.querySelector<SVGElement>('[data-icon="close"]');
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  }

  let controller: AbortController | null = null;

  function initMobileMenu() {
    controller?.abort();
    const root = document.querySelector<HTMLElement>("[data-mobile-menu]");
    if (!root) return;
    const toggle = root.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
    if (!toggle) return;

    controller = new AbortController();
    const { signal } = controller;

    let pointerAt = 0;
    toggle.addEventListener(
      "pointerdown",
      () => {
        pointerAt = Date.now();
      },
      { signal },
    );

    toggle.addEventListener(
      "click",
      (event) => {
        event.stopPropagation();
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        setOpen(root, !isOpen);
      },
      { signal },
    );

    root.addEventListener(
      "focusin",
      () => {
        if (Date.now() - pointerAt < 400) return;
        if (toggle.getAttribute("aria-expanded") !== "true") setOpen(root, true);
      },
      { signal },
    );

    root.addEventListener(
      "focusout",
      (event) => {
        const next = (event as FocusEvent).relatedTarget as Node | null;
        if (!next || !root.contains(next)) setOpen(root, false);
      },
      { signal },
    );

    const panel = root.querySelector<HTMLElement>("[data-mobile-panel]");
    root.addEventListener(
      "click",
      (event) => {
        const target = event.target as Element | null;
        const link = target?.closest<HTMLAnchorElement>("[data-mobile-link]");
        if (!link || !root.contains(link)) return;
        if (event.defaultPrevented) return;
        const me = event as MouseEvent;
        if (me.metaKey || me.ctrlKey || me.shiftKey || me.altKey || me.button !== 0) {
          setOpen(root, false);
          return;
        }
        const href = link.getAttribute("href");
        if (!href || link.target === "_blank") {
          setOpen(root, false);
          return;
        }
        event.preventDefault();
        if (panel) panel.style.transition = "none";
        setOpen(root, false);
        
        if (panel) void panel.offsetHeight;
        window.location.href = href;
      },
      { signal },
    );

    document.addEventListener(
      "click",
      (event) => {
        const target = event.target as Element | null;
        if (!target) return;
        if (!target.closest("[data-mobile-menu]")) setOpen(root, false);
      },
      { signal },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
          setOpen(root, false);
          toggle.focus();
        }
      },
      { signal },
    );
  }

  initMobileMenu();
  document.addEventListener("astro:page-load", initMobileMenu);
</script>

<style>
  input[type="search"]::-webkit-search-cancel-button,
  input[type="search"]::-webkit-search-decoration {
    display: none;
  }
  [data-mobile-search-input]:focus-visible {
    outline: none;
  }
</style>

<script>
  let mobilePf: any = null;
  let mobileDebounce: ReturnType<typeof setTimeout>;

  async function loadMobilePagefind() {
    if (mobilePf) return mobilePf;
    try {
      const src = "/pagefind/pagefind.js";
      // @ts-ignore
      mobilePf = await import(/* @vite-ignore */ src);
      await mobilePf.options({ excerptLength: 15 });
    } catch {
      mobilePf = null;
    }
    return mobilePf;
  }

  function clearMobileResults() {
    const results = document.querySelector<HTMLElement>("[data-mobile-search-results]");
    const empty = document.querySelector<HTMLElement>("[data-mobile-search-empty]");
    const clear = document.querySelector<HTMLButtonElement>("[data-mobile-search-clear]");
    if (!results) return;
    for (const el of Array.from(results.querySelectorAll("[data-mobile-result]"))) el.remove();
    empty?.classList.add("hidden");
    clear?.classList.add("hidden");
    clear?.classList.remove("flex");
  }

  function renderMobileResults(matches: any[]) {
    const results = document.querySelector<HTMLElement>("[data-mobile-search-results]");
    const empty = document.querySelector<HTMLElement>("[data-mobile-search-empty]");
    if (!results) return;
    for (const el of Array.from(results.querySelectorAll("[data-mobile-result]"))) el.remove();
    if (matches.length === 0) {
      empty?.classList.remove("hidden");
      return;
    }
    empty?.classList.add("hidden");
    for (const match of matches) {
      const item = document.createElement("a");
      item.href = match.url;
      item.setAttribute("role", "option");
      item.setAttribute("data-mobile-result", "");
      item.setAttribute("data-mobile-link", "");
      item.className =
        "flex flex-col gap-0.5 px-3 py-2.5 text-sm rounded-xl transition hover:bg-brand-primary/5 dark:hover:bg-brand-quaternary/5 cursor-pointer";
      const titleEl = document.createElement("span");
      titleEl.className = "font-medium text-brand-primary dark:text-brand-quaternary";
      titleEl.textContent = match.meta?.title ?? "Untitled";
      const excerptEl = document.createElement("span");
      excerptEl.className = "text-xs text-brand-primary/60 dark:text-brand-quaternary/60 line-clamp-1";
      excerptEl.innerHTML = match.excerpt;
      item.appendChild(titleEl);
      item.appendChild(excerptEl);
      results.appendChild(item);
    }
  }

  async function handleMobileInput(value: string) {
    const clear = document.querySelector<HTMLButtonElement>("[data-mobile-search-clear]");
    const hasValue = value.trim().length > 0;
    clear?.classList.toggle("hidden", !hasValue);
    clear?.classList.toggle("flex", hasValue);
    if (!hasValue) { clearMobileResults(); return; }
    const pf = await loadMobilePagefind();
    if (!pf) return;
    const search = await pf.debouncedSearch(value);
    if (!search) return;
    const top8 = search.results.slice(0, 8);
    const data = await Promise.all(top8.map((r: any) => r.data()));
    renderMobileResults(data);
  }

  function initMobileSearch() {
    const input = document.querySelector<HTMLInputElement>("[data-mobile-search-input]");
    const clear = document.querySelector<HTMLButtonElement>("[data-mobile-search-clear]");
    if (!input) return;

    input.addEventListener("input", (e) => {
      clearTimeout(mobileDebounce);
      mobileDebounce = setTimeout(() => handleMobileInput((e.target as HTMLInputElement).value), 120);
    });

    clear?.addEventListener("click", () => {
      input.value = "";
      input.focus();
      clearMobileResults();
    });
  }

  initMobileSearch();
  document.addEventListener("astro:page-load", initMobileSearch);
</script>
