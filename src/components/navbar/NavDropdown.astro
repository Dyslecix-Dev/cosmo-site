---
import type { CollectionEntry } from "astro:content";

interface Props {
  docs: CollectionEntry<"docs">[];
  pathname: string;
  isActive: boolean;
}

const { docs, pathname, isActive } = Astro.props;
---

<li class="relative z-10" data-dropdown>
  <button
    type="button"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="nav-docs-menu"
    data-nav-item
    data-dropdown-toggle
    aria-current={isActive ? "page" : undefined}
    class:list={[
      "inline-flex items-center gap-1 rounded-full px-4 py-2 text-sm font-medium transition",
      isActive
        ? "text-brand-primary dark:text-brand-quaternary"
        : "text-brand-primary/70 dark:text-brand-quaternary/70 hover:text-brand-primary dark:hover:text-brand-quaternary",
    ]}
  >
    Docs
    <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5 transition-transform duration-200 data-[open=true]:rotate-180" data-dropdown-chevron>
      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.39a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"></path>
    </svg>
  </button>

  <div
    id="nav-docs-menu"
    role="menu"
    data-dropdown-menu
    class="absolute left-1/2 -translate-x-1/2 mt-3 w-72 origin-top rounded-2xl border border-brand-primary/10 dark:border-brand-quaternary/10 bg-brand-quaternary/95 dark:bg-brand-primary/95 backdrop-blur-xl p-2 shadow-[0_20px_60px_rgba(0,0,0,0.15)] opacity-0 -translate-y-1 scale-95 pointer-events-none transition duration-200 ease-out data-[open=true]:opacity-100 data-[open=true]:translate-y-0 data-[open=true]:scale-100 data-[open=true]:pointer-events-auto"
  >
    <div class="px-3 pb-2 pt-1 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-brand-secondary dark:text-brand-tertiary">Guides</div>
    {
      docs.map((doc, i) => {
        const href = `/docs/${doc.id}`;
        const isCurrent = pathname === href || pathname === `${href}/`;
        return (
          <a
            href={href}
            role="menuitem"
            aria-current={isCurrent ? "page" : undefined}
            class:list={[
              "group flex items-center gap-3 rounded-xl px-3 py-2 text-sm transition",
              isCurrent
                ? "bg-brand-primary/8 dark:bg-brand-quaternary/8 font-medium text-brand-primary dark:text-brand-quaternary"
                : "text-brand-primary/80 dark:text-brand-quaternary/80 hover:bg-brand-primary/5 dark:hover:bg-brand-quaternary/5 hover:text-brand-primary dark:hover:text-brand-quaternary",
            ]}
          >
            <span class="font-mono text-[0.7rem] text-brand-secondary dark:text-brand-tertiary tabular-nums">0{i + 1}</span>
            <span class="flex-1">{doc.data.title}</span>
            <span aria-hidden="true" class="text-brand-secondary dark:text-brand-tertiary opacity-0 transition group-hover:opacity-100">&rarr;</span>
          </a>
        );
      })
    }
  </div>
</li>

<script>
  function setOpen(dropdown: Element, open: boolean) {
    const toggle = dropdown.querySelector<HTMLButtonElement>("[data-dropdown-toggle]");
    const menu = dropdown.querySelector<HTMLElement>("[data-dropdown-menu]");
    const chevron = dropdown.querySelector<HTMLElement>("[data-dropdown-chevron]");
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", String(open));
    menu.dataset.open = String(open);
    if (chevron) chevron.dataset.open = String(open);
  }

  function closeAllDropdowns() {
    for (const dd of document.querySelectorAll("[data-dropdown]")) setOpen(dd, false);
  }

  function initDropdowns() {
    document.addEventListener("click", (event) => {
      const target = event.target as Element | null;
      if (!target) return;

      const toggle = target.closest("[data-dropdown-toggle]");
      if (toggle) {
        const dd = toggle.closest("[data-dropdown]");
        if (!dd) return;
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        closeAllDropdowns();
        if (!isOpen) setOpen(dd, true);
        return;
      }

      if (!target.closest("[data-dropdown]")) closeAllDropdowns();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeAllDropdowns();
    });
  }

  initDropdowns();
  document.addEventListener("astro:page-load", closeAllDropdowns);
</script>
