---
import type { CollectionEntry } from "astro:content";

interface Props {
  docs: CollectionEntry<"docs">[];
  pathname: string;
  isActive: boolean;
}

const { docs, pathname, isActive } = Astro.props;
---

<li class="relative z-10" data-dropdown>
  <button
    type="button"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="nav-docs-menu"
    data-nav-item
    data-dropdown-toggle
    aria-current={isActive ? "page" : undefined}
    class:list={[
      "inline-flex items-center gap-1 rounded-full px-4 py-2 text-sm font-medium transition",
      isActive
        ? "text-brand-primary dark:text-brand-quaternary"
        : "text-brand-primary/70 dark:text-brand-quaternary/70 hover:text-brand-primary dark:hover:text-brand-quaternary",
    ]}
  >
    Docs
    <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5 transition-transform duration-200 data-[open=true]:rotate-180" data-dropdown-chevron>
      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.39a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"></path>
    </svg>
  </button>

  <div
    id="nav-docs-menu"
    data-dropdown-menu
    class="absolute left-1/2 -translate-x-1/2 mt-3 w-72 origin-top rounded-2xl border border-brand-primary/10 dark:border-brand-quaternary/10 bg-brand-quaternary/95 dark:bg-brand-primary/95 backdrop-blur-xl p-2 shadow-[0_20px_60px_rgba(0,0,0,0.15)] opacity-0 -translate-y-1 scale-95 pointer-events-none transition duration-200 ease-out data-[open=true]:opacity-100 data-[open=true]:translate-y-0 data-[open=true]:scale-100 data-[open=true]:pointer-events-auto"
  >
    <a
      href="/docs"
      aria-current={pathname === "/docs" || pathname === "/docs/" ? "page" : undefined}
      class:list={[
        "group flex items-center gap-3 rounded-xl px-3 py-2 text-sm transition",
        pathname === "/docs" || pathname === "/docs/"
          ? "bg-brand-primary/8 dark:bg-brand-quaternary/8 font-medium text-brand-primary dark:text-brand-quaternary"
          : "text-brand-primary dark:text-brand-quaternary hover:bg-brand-primary/5 dark:hover:bg-brand-quaternary/5",
      ]}
    >
      <span class="font-mono text-[0.7rem] text-brand-secondary dark:text-brand-tertiary">&#9733;</span>
      <span class="flex-1 font-medium">All guides</span>
      <span aria-hidden="true" class="text-brand-secondary dark:text-brand-tertiary opacity-0 transition group-hover:opacity-100">&rarr;</span>
    </a>
    <div class="mx-3 my-2 h-px bg-brand-primary/10 dark:bg-brand-quaternary/10"></div>
    <div class="px-3 pb-2 pt-1 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-brand-secondary dark:text-brand-tertiary">Guides</div>
    {
      docs.map((doc, i) => {
        const href = `/docs/${doc.id}`;
        const isCurrent = pathname === href || pathname === `${href}/`;
        return (
          <a
            href={href}
            aria-current={isCurrent ? "page" : undefined}
            class:list={[
              "group flex items-center gap-3 rounded-xl px-3 py-2 text-sm transition",
              isCurrent
                ? "bg-brand-primary/8 dark:bg-brand-quaternary/8 font-medium text-brand-primary dark:text-brand-quaternary"
                : "text-brand-primary/80 dark:text-brand-quaternary/80 hover:bg-brand-primary/5 dark:hover:bg-brand-quaternary/5 hover:text-brand-primary dark:hover:text-brand-quaternary",
            ]}
          >
            <span class="font-mono text-[0.7rem] text-brand-secondary dark:text-brand-tertiary tabular-nums">0{i + 1}</span>
            <span class="flex-1">{doc.data.title}</span>
            <span aria-hidden="true" class="text-brand-secondary dark:text-brand-tertiary opacity-0 transition group-hover:opacity-100">&rarr;</span>
          </a>
        );
      })
    }
  </div>
</li>

<script>
  function notifyState() {
    const container = document.querySelector("[data-nav-pill]");
    container?.dispatchEvent(new CustomEvent("dropdown:state", { bubbles: false }));
  }

  function setOpen(dropdown: Element, open: boolean) {
    const toggle = dropdown.querySelector<HTMLButtonElement>("[data-dropdown-toggle]");
    const menu = dropdown.querySelector<HTMLElement>("[data-dropdown-menu]");
    const chevron = dropdown.querySelector<HTMLElement>("[data-dropdown-chevron]");
    if (!toggle || !menu) return;
    const wasOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(open));
    menu.dataset.open = String(open);
    if (chevron) chevron.dataset.open = String(open);
    if (wasOpen !== open) notifyState();
  }

  function closeAllDropdowns() {
    for (const dd of document.querySelectorAll("[data-dropdown]")) setOpen(dd, false);
  }

  function bindDocumentListeners() {
    const w = window as unknown as { __dropdownDocBound?: boolean; __dropdownPointerAt?: number };
    if (w.__dropdownDocBound) return;
    w.__dropdownDocBound = true;

    // Track pointer interactions on a dropdown toggle so the focusin handler
    // can ignore the focus that the browser fires on mousedown — otherwise
    // focusin opens the dropdown and the subsequent click immediately closes
    // it (because click sees aria-expanded="true").
    document.addEventListener("pointerdown", (event) => {
      const target = event.target as Element | null;
      if (target?.closest("[data-dropdown-toggle]")) {
        w.__dropdownPointerAt = Date.now();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target as Element | null;
      if (!target) return;

      const toggle = target.closest("[data-dropdown-toggle]");
      if (toggle) {
        const dd = toggle.closest("[data-dropdown]");
        if (!dd) return;
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        // Close any *other* open dropdowns first, then toggle this one.
        // Closing this one and then re-opening it inside the same click would
        // briefly fire the closed-state event and snap the pill to Home.
        for (const other of document.querySelectorAll("[data-dropdown]")) {
          if (other !== dd) setOpen(other, false);
        }
        setOpen(dd, !isOpen);
        return;
      }

      if (!target.closest("[data-dropdown]")) closeAllDropdowns();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        const active = document.activeElement;
        const dd = active?.closest("[data-dropdown]");
        closeAllDropdowns();
        if (dd) {
          const toggle = dd.querySelector<HTMLButtonElement>("[data-dropdown-toggle]");
          toggle?.focus();
        }
      }
    });

    // Delegated focusin/focusout so listeners survive Astro view transitions
    // (NavDropdown markup is replaced on each page swap; document persists).
    document.addEventListener("focusin", (event) => {
      const target = event.target as Element | null;
      const dd = target?.closest("[data-dropdown]");
      if (!dd) return;
      if (!target?.closest("[data-dropdown-toggle]")) return;
      // Skip if a pointer interaction caused this focus — let the click
      // handler decide; otherwise we'd open here, then the click would close.
      if (Date.now() - (w.__dropdownPointerAt ?? 0) < 400) return;

      for (const other of document.querySelectorAll("[data-dropdown]")) {
        if (other !== dd) setOpen(other, false);
      }
      setOpen(dd, true);
    });

    document.addEventListener("focusout", (event) => {
      const target = event.target as Element | null;
      const dd = target?.closest("[data-dropdown]");
      if (!dd) return;
      const next = (event as FocusEvent).relatedTarget as Node | null;
      if (!next || !dd.contains(next)) setOpen(dd, false);
    });
  }

  function initDropdowns() {
    bindDocumentListeners();
    closeAllDropdowns();
    notifyState();
  }

  initDropdowns();
  document.addEventListener("astro:page-load", initDropdowns);
</script>
