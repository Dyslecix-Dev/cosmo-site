---
import { Image } from "astro:assets";

import rocket from "@/assets/rocket.png";

const installCmd = "pnpm create astro@latest -- --template Dyslecix-Dev/cosmo/template my-site";

const statusPhrases = ["Now boarding", "Pre-flight check", "Cleared for launch"];

const headlineLine1 = "One ship";
const headlineLine2 = "Any orbit";
---

<section class="relative isolate flex flex-col justify-center px-6 sm:px-10 pt-24 pb-24 sm:pt-32 sm:pb-32 min-h-dvh">
  <div aria-hidden="true" class="aurora pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <span class="aurora-blob aurora-blob-1"></span>
    <span class="aurora-blob aurora-blob-2"></span>
    <span class="aurora-blob aurora-blob-3"></span>
  </div>
  <div aria-hidden="true" class="grid-overlay pointer-events-none absolute inset-0 -z-10"></div>

  <div aria-hidden="true" class="floating-stars pointer-events-none absolute inset-0 -z-10">
    <span class="float-star float-star-1">&#10022;</span>
    <span class="float-star float-star-2">&#10022;</span>
    <span class="float-star float-star-3">&#10022;</span>
    <span class="float-star float-star-4">&#10022;</span>
    <span class="float-star float-star-5">&#10022;</span>
  </div>

  <div aria-hidden="true" data-rocket class="hero-rocket pointer-events-none absolute left-0 top-0 w-24 sm:w-32 lg:w-36">
    <div class="rocket-cruiser relative">
      <Image src={rocket} alt="" class="rocket-cruiser-body relative z-10 h-auto w-full" />
    </div>
  </div>

  <div class="mx-auto w-full max-w-6xl">
    <div class="hero-reveal flex items-center gap-3 font-mono text-xs uppercase tracking-[0.2em] text-brand-secondary dark:text-brand-tertiary">
      <span aria-hidden="true" class="orbit-marker relative inline-block h-3 w-3">
        <span class="absolute inset-0 rounded-full border border-current opacity-30"></span>
        <span class="absolute inset-0 origin-center orbit-rotator">
          <span class="absolute -top-0.5 left-1/2 -translate-x-1/2 h-1.5 w-1.5 rounded-full bg-brand-tertiary shadow-[0_0_6px_currentColor]"></span>
        </span>
        <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-1 w-1 rounded-full bg-current opacity-60"></span>
      </span>
      <span class="status-cycle relative inline-block h-4 min-w-[10ch] overflow-hidden align-middle">
        {statusPhrases.map((phrase, i) => (
          <span
            class={`status-phrase absolute inset-0 ${i === 0 ? "" : "opacity-0"}`}
            data-status-index={String(i)}
            aria-hidden={i === 0 ? undefined : "true"}
          >{phrase}</span>
        ))}
      </span>
      <span aria-hidden="true">&middot;</span>
      <span>v0.2</span>
    </div>

    <h1 class="mt-10 font-heading font-bold tracking-tight leading-[0.88] text-[clamp(3rem,11vw,11rem)]">
      <span class="block overflow-hidden">
        <span class="split-line hero-outline block" data-text={headlineLine1}>{headlineLine1}</span>
      </span>
      <span class="block overflow-hidden">
        <span class="split-line hero-outline block italic font-normal text-brand-secondary dark:text-brand-tertiary pl-2 pb-6" data-text={headlineLine2}>{headlineLine2}</span>
      </span>
    </h1>

    <div class="mt-10 grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-end">
      <p class="hero-reveal hero-outline-soft max-w-xl text-lg sm:text-xl dark:text-brand-quaternary text-brand-primary">
        Cosmo is the free Astro-powered launchpad for fast, scalable, static sites
      </p>
    </div>

    <div class="hero-reveal mt-12 max-w-3xl">
      <div class="group relative flex items-center gap-3 rounded-xl border border-brand-primary/20 dark:border-brand-quaternary/20 bg-brand-quaternary/60 dark:bg-brand-primary/60 backdrop-blur px-4 sm:px-5 py-4 font-mono text-sm sm:text-base shadow-[0_1px_0_rgba(255,255,255,0.05)_inset]">
        <span aria-hidden="true" class="text-brand-tertiary select-none">$</span>
        <code id="install-cmd" class="flex-1 overflow-x-auto whitespace-nowrap text-brand-primary dark:text-brand-quaternary">{installCmd}</code>
        <span aria-hidden="true" class="terminal-caret select-none text-brand-tertiary -ml-1">_</span>
        <button
          type="button"
          id="copy-install"
          aria-label="Copy install command"
          class="shrink-0 rounded-md p-2 text-brand-secondary dark:text-brand-tertiary hover:bg-brand-primary/10 dark:hover:bg-brand-quaternary/10 transition"
        >
          <svg data-icon="copy" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg data-icon="check" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 hidden">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <div class="hero-reveal mt-8 flex flex-wrap items-center gap-4">
      <a
        href="/docs"
        data-magnetic
        class="group relative inline-flex items-center gap-2 overflow-hidden rounded-full bg-brand-primary dark:bg-brand-quaternary px-7 py-3.5 text-sm font-semibold text-brand-quaternary dark:text-brand-primary transition will-change-transform"
      >
        <span class="relative z-10">Launch</span>
        <span aria-hidden="true" class="relative z-10 transition-transform group-hover:translate-x-1">&rarr;</span>
        <span aria-hidden="true" class="absolute inset-0 z-0 translate-y-full bg-brand-secondary dark:bg-brand-tertiary transition-transform duration-500 ease-out group-hover:translate-y-0"></span>
      </a>
      <a
        href="https://github.com/Dyslecix-Dev/cosmo"
        target="_blank"
        rel="noopener"
        data-magnetic
        class="inline-flex items-center gap-2 rounded-full border border-brand-primary/30 dark:border-brand-quaternary/30 px-6 py-3.5 text-sm font-semibold text-brand-primary dark:text-brand-quaternary transition hover:border-brand-primary dark:hover:border-brand-quaternary will-change-transform backdrop-blur-xl"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1-.02-1.96-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.97.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.45.11-3.03 0 0 .97-.31 3.18 1.18a11.04 11.04 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.58.23 2.74.11 3.03.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .31.21.68.8.56C20.21 21.39 23.5 17.07 23.5 12 23.5 5.65 18.35.5 12 .5Z"></path>
        </svg>
        GitHub
      </a>
      <a
        href="https://github.com/Dyslecix-Dev/cosmo"
        target="_blank"
        rel="noopener"
        aria-label="GitHub stars"
        class="group relative inline-flex items-center rounded-md ring-2 ring-transparent transition duration-300 hover:-translate-y-0.5 hover:ring-brand-tertiary hover:shadow-[0_0_28px_4px_color-mix(in_oklch,var(--color-brand-tertiary)_55%,transparent),0_0_0_5px_color-mix(in_oklch,var(--color-brand-tertiary)_28%,transparent)]"
      >
        <img
          src="https://img.shields.io/github/stars/Dyslecix-Dev/cosmo?style=for-the-badge&logo=github&label=stars&color=24292e&labelColor=24292e&logoColor=white"
          alt="GitHub stars"
          class="h-9 w-auto rounded-md transition-transform duration-300 group-hover:scale-[1.06]"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </div>
</section>

<style>
  .hero-reveal {
    opacity: 0;
  }

  .split-line {
    display: block;
    transform: translateY(110%);
    will-change: transform;
  }

  .hero-outline {
    paint-order: stroke fill;
    -webkit-text-stroke: 1.5px color-mix(in oklch, var(--color-brand-tertiary) 80%, transparent);
  }

  :where(.dark) .hero-outline {
    -webkit-text-stroke-color: color-mix(in oklch, var(--color-brand-tertiary) 90%, transparent);
  }

  .hero-outline-soft {
    paint-order: stroke fill;
    -webkit-text-stroke: 0.5px color-mix(in oklch, var(--color-brand-tertiary) 55%, transparent);
  }

  .aurora {
    filter: blur(80px) saturate(140%);
  }

  .aurora-blob {
    position: absolute;
    display: block;
    border-radius: 9999px;
    opacity: 0.55;
    mix-blend-mode: multiply;
  }

  :where(.dark) .aurora-blob {
    mix-blend-mode: screen;
    opacity: 0.45;
  }

  .aurora-blob-1 {
    top: -10%;
    left: -10%;
    width: 55vw;
    height: 55vw;
    background: var(--color-brand-tertiary);
    animation: aurora-1 18s ease-in-out infinite alternate;
  }

  .aurora-blob-2 {
    top: 20%;
    right: -15%;
    width: 50vw;
    height: 50vw;
    background: var(--color-brand-secondary);
    animation: aurora-2 22s ease-in-out infinite alternate;
  }

  .aurora-blob-3 {
    bottom: -20%;
    left: 25%;
    width: 45vw;
    height: 45vw;
    background: var(--color-brand-primary);
    opacity: 0.35;
    animation: aurora-3 26s ease-in-out infinite alternate;
  }

  @keyframes aurora-1 {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(8vw, 6vh, 0) scale(1.15); }
  }

  @keyframes aurora-2 {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(-10vw, 4vh, 0) scale(1.1); }
  }

  @keyframes aurora-3 {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(6vw, -8vh, 0) scale(1.2); }
  }

  .grid-overlay {
    background-image:
      linear-gradient(to right, color-mix(in oklch, var(--color-brand-primary) 6%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklch, var(--color-brand-primary) 6%, transparent) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 75%);
  }

  :where(.dark) .grid-overlay {
    background-image:
      linear-gradient(to right, color-mix(in oklch, var(--color-brand-quaternary) 6%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklch, var(--color-brand-quaternary) 6%, transparent) 1px, transparent 1px);
  }

  .floating-stars {
    color: color-mix(in oklch, var(--color-brand-tertiary) 70%, transparent);
  }

  .float-star {
    position: absolute;
    font-size: 1.25rem;
    opacity: 0.5;
    will-change: transform;
  }

  .float-star-1 { top: 18%; left: 8%; animation: float-bob 7s ease-in-out infinite, float-spin 18s linear infinite; }
  .float-star-2 { top: 32%; right: 12%; font-size: 0.9rem; animation: float-bob 9s ease-in-out infinite -2s, float-spin 22s linear infinite reverse; }
  .float-star-3 { bottom: 28%; left: 22%; font-size: 1.5rem; opacity: 0.35; animation: float-bob 11s ease-in-out infinite -4s, float-spin 26s linear infinite; }
  .float-star-4 { top: 60%; right: 18%; font-size: 0.75rem; animation: float-bob 8s ease-in-out infinite -1s, float-spin 14s linear infinite reverse; }
  .float-star-5 { bottom: 14%; right: 32%; font-size: 1rem; opacity: 0.4; animation: float-bob 10s ease-in-out infinite -3s, float-spin 20s linear infinite; }

  @keyframes float-bob {
    0%, 100% { transform: translateY(0) translateX(0); }
    50% { transform: translateY(-14px) translateX(6px); }
  }

  @keyframes float-spin {
    from { rotate: 0deg; }
    to { rotate: 360deg; }
  }

  .orbit-rotator {
    animation: orbit 4s linear infinite;
  }

  @keyframes orbit {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .terminal-caret {
    animation: caret-blink 1.1s steps(1) infinite;
  }

  @keyframes caret-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  .hero-rocket {
    will-change: transform;
  }

  .rocket-cruiser {
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal {
      opacity: 1;
    }

    .split-line {
      transform: none;
    }

    .aurora-blob,
    .float-star,
    .orbit-rotator,
    .terminal-caret {
      animation: none;
    }
  }
</style>

<script>
  import { animate, stagger } from "motion";
  import { isMotionDisabled, MOTION_EVENT } from "@/lib/motion";

  const cleanups: Array<() => void> = [];

  function reset() {
    while (cleanups.length) {
      try { cleanups.pop()?.(); } catch { /* fail silently */ }
    }
  }

  function initHero() {
    const reduce = isMotionDisabled();

    const splitLines = document.querySelectorAll<HTMLElement>(".split-line");
    if (splitLines.length) {
      if (reduce) {
        for (const el of splitLines) el.style.transform = "translateY(0)";
      } else {
        animate(
          splitLines,
          { transform: ["translateY(110%)", "translateY(0%)"] },
          { duration: 0.9, delay: stagger(0.12, { startDelay: 0.15 }), ease: [0.22, 1, 0.36, 1] },
        );
      }
    }

    const heroEls = document.querySelectorAll<HTMLElement>(".hero-reveal");
    if (heroEls.length) {
      if (reduce) {
        for (const el of heroEls) el.style.opacity = "1";
      } else {
        animate(
          heroEls,
          { opacity: [0, 1], transform: ["translateY(16px)", "translateY(0)"] },
          { duration: 0.7, delay: stagger(0.07, { startDelay: 0.4 }), ease: [0.22, 1, 0.36, 1] },
        );
      }
    }
  }

  function initMagnetic() {
    const reduce = isMotionDisabled();
    if (reduce) return;
    const els = document.querySelectorAll<HTMLElement>("[data-magnetic]");
    for (const el of els) {
      const onMove = (event: PointerEvent) => {
        const rect = el.getBoundingClientRect();
        const x = event.clientX - (rect.left + rect.width / 2);
        const y = event.clientY - (rect.top + rect.height / 2);
        animate(el, { transform: `translate(${x * 0.18}px, ${y * 0.25}px)` }, { duration: 0.4, ease: "easeOut" });
      };
      const onLeave = () => {
        animate(el, { transform: "translate(0px, 0px)" }, { duration: 0.5, ease: [0.22, 1, 0.36, 1] });
      };
      el.addEventListener("pointermove", onMove);
      el.addEventListener("pointerleave", onLeave);
      cleanups.push(() => {
        el.removeEventListener("pointermove", onMove);
        el.removeEventListener("pointerleave", onLeave);
      });
    }
  }

  function initStatusCycle() {
    const reduce = isMotionDisabled();
    const phrases = document.querySelectorAll<HTMLElement>(".status-phrase");
    if (phrases.length < 2 || reduce) return;
    let current = 0;
    const tick = () => {
      const next = (current + 1) % phrases.length;
      animate(phrases[current], { opacity: [1, 0], transform: ["translateY(0)", "translateY(-8px)"] }, { duration: 0.4, ease: "easeIn" });
      animate(phrases[next], { opacity: [0, 1], transform: ["translateY(8px)", "translateY(0)"] }, { duration: 0.4, delay: 0.15, ease: "easeOut" });
      phrases[current].setAttribute("aria-hidden", "true");
      phrases[next].removeAttribute("aria-hidden");
      current = next;
    };
    const interval = window.setInterval(tick, 3000);
    cleanups.push(() => window.clearInterval(interval));
  }

  function initCopyButton() {
    const btn = document.getElementById("copy-install");
    const code = document.getElementById("install-cmd");
    if (!btn || !code) return;
    const onClick = async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        const copyIcon = btn.querySelector<SVGElement>('[data-icon="copy"]');
        const checkIcon = btn.querySelector<SVGElement>('[data-icon="check"]');
        copyIcon?.classList.add("hidden");
        checkIcon?.classList.remove("hidden");
        window.setTimeout(() => {
          copyIcon?.classList.remove("hidden");
          checkIcon?.classList.add("hidden");
        }, 1500);
      } catch {
        // fail silently
      }
    };
    btn.addEventListener("click", onClick);
    cleanups.push(() => btn.removeEventListener("click", onClick));
  }

  function initRocket() {
    const reduce = isMotionDisabled();
    const rocketEl = document.querySelector<HTMLElement>("[data-rocket]");
    const cruiser = rocketEl?.querySelector<HTMLElement>(".rocket-cruiser");
    if (!rocketEl || !cruiser) return;

    if (reduce) {
      rocketEl.style.transform = "translate(20vw, 30vh)";
      cruiser.style.transform = "rotate(45deg)";
      return;
    }

    cruiser.style.transform = "none";

    let cancelled = false;
    let currentAnim: { stop: () => void } | null = null;

    const BASE_DURATION = 12;
    const DURATION_VARIANCE = 10;
    const PAUSE_MIN = 800;
    const PAUSE_MAX = 2600;

    const buildPath = (startX: number, startY: number, endX: number, endY: number) => {
      const N = 24;
      const xs: number[] = [];
      const ys: number[] = [];
      const dx = endX - startX;
      const dy = endY - startY;
      const len = Math.hypot(dx, dy) || 1;
      const px = -dy / len;
      const py = dx / len;
      const amp = (8 + Math.random() * 12) * (Math.random() < 0.5 ? -1 : 1);
      for (let i = 0; i < N; i++) {
        const t = i / (N - 1);
        const baseX = startX + dx * t;
        const baseY = startY + dy * t;
        const offset = Math.sin(t * Math.PI) * amp;
        xs.push(baseX + px * offset);
        ys.push(baseY + py * offset);
      }
      return { xs, ys };
    };

    const unwrapAngles = (angles: number[]) => {
      for (let i = 1; i < angles.length; i++) {
        let diff = angles[i] - angles[i - 1];
        while (diff > 180) {
          angles[i] -= 360;
          diff -= 360;
        }
        while (diff < -180) {
          angles[i] += 360;
          diff += 360;
        }
      }
      return angles;
    };

    const smoothAngles = (angles: number[]) => {
      const out = angles.slice();
      for (let pass = 0; pass < 2; pass++) {
        const next = out.slice();
        for (let i = 1; i < out.length - 1; i++) {
          next[i] = (out[i - 1] + out[i] * 2 + out[i + 1]) / 4;
        }
        out.splice(0, out.length, ...next);
      }
      return out;
    };

    const run = async () => {
      while (!cancelled) {
        const startSide = Math.random() < 0.5 ? "left" : "right";
        const startY = 10 + Math.random() * 70;
        const endY = 10 + Math.random() * 70;
        const startX = startSide === "left" ? -25 : 115;
        const endX = startSide === "left" ? 115 : -25;
        const duration = BASE_DURATION + Math.random() * DURATION_VARIANCE;

        const { xs, ys } = buildPath(startX, startY, endX, endY);

        const rawAngles: number[] = [];
        for (let i = 0; i < xs.length; i++) {
          const a = i === 0 ? 0 : i - 1;
          const b = i === xs.length - 1 ? i : i + 1;
          const ax = (xs[b] - xs[a]) * window.innerWidth / 100;
          const ay = (ys[b] - ys[a]) * window.innerHeight / 100;
          rawAngles.push(Math.atan2(ay, ax) * 180 / Math.PI + 90);
        }
        const angles = smoothAngles(unwrapAngles(rawAngles));

        const frames = xs.map(
          (x, i) => `translate(${x}vw, ${ys[i]}vh) rotate(${angles[i]}deg)`,
        );

        rocketEl.style.transform = frames[0];

        const anim = animate(
          rocketEl,
          { transform: frames },
          { duration, ease: "linear" },
        );
        currentAnim = { stop: () => anim.stop() };
        try {
          await anim.finished;
        } catch {
          return;
        }
        if (cancelled) return;
        await new Promise((r) => setTimeout(r, PAUSE_MIN + Math.random() * (PAUSE_MAX - PAUSE_MIN)));
      }
    };

    run();
    cleanups.push(() => {
      cancelled = true;
      currentAnim?.stop();
    });
  }

  function initAll() {
    reset();
    initHero();
    initMagnetic();
    initStatusCycle();
    initCopyButton();
    initRocket();
  }

  initAll();
  document.addEventListener("astro:page-load", initAll);
  document.addEventListener(MOTION_EVENT, initAll);
</script>
