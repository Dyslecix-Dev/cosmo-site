---
const cards = [
  {
    href: "/blueprint",
    code: "TX-001",
    coords: "33.81° N · 117.92° W",
    eyebrow: "Blueprint",
    title: "Engineering Schematics",
    body: "How we re-tooled Cosmo for this guide. Useful for making your own docs and marketing sites.",
    cta: "Open the blueprint",
    illustration: "blueprint" as const,
  },
  {
    href: "/roadmap",
    code: "TX-002",
    coords: "28.42° N · 81.58° W",
    eyebrow: "Roadmap",
    title: "Future Coordinates",
    body: "Get a sneak peak at our next destination. Ping our GitHub for future requests.",
    cta: "Read the roadmap",
    illustration: "trajectory" as const,
  },
];
---

<section data-mission-section class="relative overflow-hidden">
  <div aria-hidden="true" class="mission-matrix pointer-events-none absolute inset-0 z-0"></div>
  <div aria-hidden="true" class="mission-aurora-1 pointer-events-none absolute z-0"></div>
  <div aria-hidden="true" class="mission-aurora-2 pointer-events-none absolute z-0"></div>

  <div class="mx-auto max-w-6xl px-6 sm:px-10 py-16 sm:py-24 lg:py-32 relative z-10">
    <div class="reveal-on-scroll">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-brand-secondary dark:text-brand-tertiary">[ 03 / Mission control ]</p>
        <h2 class="mt-4 font-heading text-4xl sm:text-6xl font-bold tracking-tight leading-[0.95]">
          Where to next, captain?
          <span class="block italic font-normal text-brand-secondary dark:text-brand-tertiary mt-2">Choose your transmission</span>
        </h2>
    </div>

    <div
      class="reveal-on-scroll mt-16 grid gap-8 md:grid-cols-[1.05fr_0.95fr] md:items-stretch"
      data-mission-stage
    >
      <div class="mission-tablet relative">
        <span aria-hidden="true" class="mission-tablet-camera"></span>
        <span aria-hidden="true" class="mission-tablet-home"></span>

        <div class="mission-tablet-screen relative overflow-hidden">
          <span aria-hidden="true" class="mission-bracket mission-bracket-tl"></span>
          <span aria-hidden="true" class="mission-bracket mission-bracket-tr"></span>
          <span aria-hidden="true" class="mission-bracket mission-bracket-bl"></span>
          <span aria-hidden="true" class="mission-bracket mission-bracket-br"></span>
          <span aria-hidden="true" class="mission-tablet-grid pointer-events-none"></span>

          <div class="relative z-10 flex items-center justify-between px-6 sm:px-8 pt-6">
            <div class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.22em] text-brand-secondary dark:text-brand-tertiary">
              <span aria-hidden="true" class="mission-pulse inline-block h-1.5 w-1.5 rounded-full bg-brand-secondary dark:bg-brand-tertiary"></span>
              <span data-tablet-code>{cards[0].code}</span>
              <span aria-hidden="true" class="opacity-50">//</span>
              <span class="opacity-80">Active</span>
            </div>
            <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-brand-secondary/70 dark:text-brand-tertiary/70" data-tablet-eyebrow>{cards[0].eyebrow}</span>
          </div>

          <div class="relative z-10 mt-6 mx-3 sm:mx-5" data-tablet-slides>
            {cards.map((card, i) => (
              <a
                href={card.href}
                class:list={[
                  "mission-slide block",
                  i === 0 ? "is-active" : "",
                ]}
                data-tablet-slide
                data-index={i}
              >
                <span aria-hidden="true" class="mission-slide-hover-ring"></span>
                <div class="relative">
                  <h3 class="font-heading text-2xl sm:text-3xl font-bold tracking-tight leading-tight text-brand-primary dark:text-brand-quaternary">
                    {card.title}
                  </h3>
                  <p class="mt-4 text-sm sm:text-base leading-relaxed text-brand-primary/75 dark:text-brand-quaternary/75">
                    {card.body}
                  </p>

                  <div class="mt-7 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between sm:gap-4">
                    <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-brand-secondary dark:text-brand-tertiary">
                      <span>{card.cta}</span>
                      <span aria-hidden="true" class="mission-arrow inline-block transition-transform duration-300">&rarr;</span>
                    </span>
                    <span class="font-mono text-[9px] uppercase tracking-[0.22em] text-brand-primary/40 dark:text-brand-quaternary/35 sm:text-right">{card.coords}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>

          <div class="relative z-10 mt-8 px-6 sm:px-8 pb-6 flex items-center justify-between gap-4">
            <div class="flex items-center gap-2" role="tablist" aria-label="Transmissions">
              {cards.map((card, i) => (
                <button
                  type="button"
                  role="tab"
                  aria-label={`Show ${card.eyebrow}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  data-tablet-dot
                  data-index={i}
                  class:list={[
                    "mission-dot inline-flex h-3 w-10 rounded-full transition-all duration-300",
                    i === 0
                      ? "bg-brand-secondary dark:bg-brand-tertiary"
                      : "bg-brand-primary/15 dark:bg-brand-quaternary/15 hover:bg-brand-primary/30 dark:hover:bg-brand-quaternary/30",
                  ]}
                ></button>
              ))}
            </div>
            <span class="font-mono text-[9px] uppercase tracking-[0.22em] text-brand-primary/40 dark:text-brand-quaternary/35">
              <span data-tablet-counter>01</span> / 02
            </span>
          </div>

          <div class="mission-progress-track absolute bottom-0 left-0 right-0 h-1.5 bg-brand-primary/10 dark:bg-brand-quaternary/10 z-10">
            <div class="mission-progress h-full bg-brand-secondary dark:bg-brand-tertiary" data-tablet-progress></div>
          </div>
        </div>
      </div>

      <div class="mission-holo relative">
        <span aria-hidden="true" class="mission-holo-beam pointer-events-none"></span>

        <div class="mission-holo-stage relative" data-holo-stage>
          {cards.map((card, i) => (
            <div
              class:list={["mission-holo-frame", i === 0 ? "is-active" : ""]}
              data-holo-frame
              data-index={i}
              aria-hidden={i === 0 ? "false" : "true"}
            >
              <div class="mission-holo-spinner">
                {card.illustration === "blueprint" && (
                  <svg viewBox="0 0 320 320" aria-hidden="true" class="mission-holo-svg">
                    <g stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" transform="translate(160 160) scale(0.82) translate(-160 -160)">
                      <rect x="40" y="40" width="240" height="240" stroke-width="1.6" />
                      <rect x="50" y="50" width="220" height="220" stroke-width="0.8" stroke-opacity="0.5" stroke-dasharray="3 4" />

                      <rect x="200" y="240" width="70" height="30" stroke-width="1" stroke-opacity="0.7" />
                      <line x1="200" y1="252" x2="270" y2="252" stroke-width="0.8" stroke-opacity="0.5" />
                      <line x1="232" y1="240" x2="232" y2="270" stroke-width="0.8" stroke-opacity="0.5" />

                      <g stroke-width="0.8" stroke-opacity="0.45">
                        <line x1="60" y1="40" x2="60" y2="48" />
                        <line x1="80" y1="40" x2="80" y2="48" />
                        <line x1="100" y1="40" x2="100" y2="48" />
                        <line x1="120" y1="40" x2="120" y2="48" />
                        <line x1="140" y1="40" x2="140" y2="48" />
                        <line x1="160" y1="40" x2="160" y2="48" />
                        <line x1="180" y1="40" x2="180" y2="48" />
                        <line x1="200" y1="40" x2="200" y2="48" />
                        <line x1="220" y1="40" x2="220" y2="48" />
                        <line x1="240" y1="40" x2="240" y2="48" />
                        <line x1="260" y1="40" x2="260" y2="48" />
                        <line x1="40" y1="60" x2="48" y2="60" />
                        <line x1="40" y1="80" x2="48" y2="80" />
                        <line x1="40" y1="100" x2="48" y2="100" />
                        <line x1="40" y1="120" x2="48" y2="120" />
                        <line x1="40" y1="140" x2="48" y2="140" />
                        <line x1="40" y1="160" x2="48" y2="160" />
                        <line x1="40" y1="180" x2="48" y2="180" />
                        <line x1="40" y1="200" x2="48" y2="200" />
                        <line x1="40" y1="220" x2="48" y2="220" />
                        <line x1="40" y1="240" x2="48" y2="240" />
                      </g>

                      <g stroke-width="0.8" stroke-opacity="0.5">
                        <line x1="60" y1="60" x2="260" y2="60" stroke-dasharray="2 3" />
                        <line x1="60" y1="56" x2="60" y2="64" />
                        <line x1="260" y1="56" x2="260" y2="64" />
                      </g>


                      <g transform="translate(150 155)" stroke-width="1.6">
                        <g class="mission-gear-large">
                          <circle r="50" />
                          <circle r="38" stroke-opacity="0.6" />
                          <circle r="14" />

                          <g stroke-width="6" stroke-linecap="butt">
                            <line x1="0" y1="-50" x2="0" y2="-58" />
                            <line x1="25" y1="-43.3" x2="29" y2="-50.2" />
                            <line x1="43.3" y1="-25" x2="50.2" y2="-29" />
                            <line x1="50" y1="0" x2="58" y2="0" />
                            <line x1="43.3" y1="25" x2="50.2" y2="29" />
                            <line x1="25" y1="43.3" x2="29" y2="50.2" />
                            <line x1="0" y1="50" x2="0" y2="58" />
                            <line x1="-25" y1="43.3" x2="-29" y2="50.2" />
                            <line x1="-43.3" y1="25" x2="-50.2" y2="29" />
                            <line x1="-50" y1="0" x2="-58" y2="0" />
                            <line x1="-43.3" y1="-25" x2="-50.2" y2="-29" />
                            <line x1="-25" y1="-43.3" x2="-29" y2="-50.2" />
                          </g>

                          <g stroke-opacity="0.55" stroke-width="1.2">
                            <line x1="0" y1="-38" x2="0" y2="-14" />
                            <line x1="0" y1="14" x2="0" y2="38" />
                            <line x1="-38" y1="0" x2="-14" y2="0" />
                            <line x1="14" y1="0" x2="38" y2="0" />
                          </g>
                        </g>
                      </g>

                      <g transform="translate(238 92)" stroke-width="1.4">
                        <g class="mission-gear-small">
                          <circle r="26" />
                          <circle r="18" stroke-opacity="0.6" />
                          <circle r="7" />
                          <g stroke-width="4" stroke-linecap="butt">
                            <line x1="0" y1="-26" x2="0" y2="-32" />
                            <line x1="18.4" y1="-18.4" x2="22.6" y2="-22.6" />
                            <line x1="26" y1="0" x2="32" y2="0" />
                            <line x1="18.4" y1="18.4" x2="22.6" y2="22.6" />
                            <line x1="0" y1="26" x2="0" y2="32" />
                            <line x1="-18.4" y1="18.4" x2="-22.6" y2="22.6" />
                            <line x1="-26" y1="0" x2="-32" y2="0" />
                            <line x1="-18.4" y1="-18.4" x2="-22.6" y2="-22.6" />
                          </g>
                        </g>
                      </g>

                      <g transform="translate(82 218)" stroke-width="1.4">
                        <g class="mission-gear-mid">
                          <circle r="32" />
                          <circle r="22" stroke-opacity="0.6" />
                          <circle r="9" />
                          <g stroke-width="5" stroke-linecap="butt">
                            <line x1="0" y1="-32" x2="0" y2="-39" />
                            <line x1="16" y1="-27.7" x2="19.5" y2="-33.8" />
                            <line x1="27.7" y1="-16" x2="33.8" y2="-19.5" />
                            <line x1="32" y1="0" x2="39" y2="0" />
                            <line x1="27.7" y1="16" x2="33.8" y2="19.5" />
                            <line x1="16" y1="27.7" x2="19.5" y2="33.8" />
                            <line x1="0" y1="32" x2="0" y2="39" />
                            <line x1="-16" y1="27.7" x2="-19.5" y2="33.8" />
                            <line x1="-27.7" y1="16" x2="-33.8" y2="19.5" />
                            <line x1="-32" y1="0" x2="-39" y2="0" />
                            <line x1="-27.7" y1="-16" x2="-33.8" y2="-19.5" />
                            <line x1="-16" y1="-27.7" x2="-19.5" y2="-33.8" />
                          </g>
                        </g>
                      </g>
                    </g>
                  </svg>
                )}
                {card.illustration === "trajectory" && (
                  <svg viewBox="0 0 320 320" aria-hidden="true" class="mission-holo-svg">
                    <g stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="160" cy="170" r="60" stroke-width="2" />
                      <ellipse cx="160" cy="170" rx="60" ry="18" stroke-width="1.5" stroke-opacity="0.55" />
                      <ellipse cx="160" cy="170" rx="80" ry="22" stroke-width="1" stroke-opacity="0.35" stroke-dasharray="3 6" />

                      <ellipse cx="160" cy="170" rx="105" ry="38" stroke-width="1.2" stroke-opacity="0.5" stroke-dasharray="2 5" />
                      <ellipse cx="160" cy="170" rx="125" ry="60" stroke-width="1" stroke-opacity="0.35" stroke-dasharray="2 5" transform="rotate(20 160 170)" />

                      <g fill="currentColor">
                        <circle cx="60" cy="170" r="4" />
                        <circle cx="265" cy="160" r="5" />
                        <circle cx="200" cy="100" r="3" />
                      </g>
                    </g>
                  </svg>
                )}
              </div>
            </div>
          ))}

          <span aria-hidden="true" class="mission-holo-glitch pointer-events-none"></span>
        </div>

        <div aria-hidden="true" class="mission-holo-base">
          <div class="mission-holo-base-disc"></div>
          <div class="mission-holo-base-rim"></div>
          <div class="mission-holo-base-glow"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mission-matrix {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='320' height='560' viewBox='0 0 320 560'><g font-family='monospace' font-size='14' fill='%23072042'><text x='8' y='18'>%E3%82%A2</text><text x='8' y='38'>7</text><text x='8' y='58'>%E3%83%9F</text><text x='8' y='78'>3</text><text x='8' y='98'>%E3%83%8D</text><text x='8' y='118'>%E3%83%A9</text><text x='8' y='138'>0</text><text x='8' y='158'>%E3%83%A0</text><text x='8' y='178'>9</text><text x='8' y='198'>%E3%82%B5</text><text x='32' y='18'>%E3%83%84</text><text x='32' y='38'>2</text><text x='32' y='58'>%E3%82%AD</text><text x='32' y='78'>4</text><text x='32' y='98'>%E3%83%92</text><text x='32' y='118'>%E3%82%B7</text><text x='56' y='18'>5</text><text x='56' y='38'>%E3%83%A0</text><text x='56' y='58'>%E3%83%A9</text><text x='56' y='78'>%E3%83%9F</text><text x='56' y='98'>0</text><text x='56' y='118'>%E3%83%8D</text><text x='56' y='138'>%E3%82%A2</text><text x='56' y='158'>3</text><text x='56' y='178'>%E3%82%AD</text><text x='56' y='198'>%E3%83%92</text><text x='56' y='218'>7</text><text x='56' y='238'>%E3%83%84</text><text x='56' y='258'>1</text><text x='56' y='278'>%E3%82%B5</text><text x='128' y='18'>%E3%83%92</text><text x='128' y='38'>4</text><text x='128' y='58'>%E3%83%9F</text><text x='128' y='78'>%E3%83%A9</text><text x='128' y='98'>2</text><text x='128' y='118'>%E3%83%84</text><text x='128' y='138'>9</text><text x='128' y='158'>%E3%83%A0</text><text x='152' y='18'>%E3%82%A2</text><text x='152' y='38'>0</text><text x='152' y='58'>%E3%82%B5</text><text x='152' y='78'>%E3%82%AD</text><text x='176' y='18'>6</text><text x='176' y='38'>%E3%83%8D</text><text x='176' y='58'>%E3%83%9F</text><text x='176' y='78'>%E3%82%B7</text><text x='176' y='98'>1</text><text x='176' y='118'>%E3%83%84</text><text x='176' y='138'>%E3%83%A9</text><text x='176' y='158'>5</text><text x='176' y='178'>%E3%82%A2</text><text x='176' y='198'>%E3%83%A0</text><text x='176' y='218'>0</text><text x='176' y='238'>%E3%83%92</text><text x='248' y='18'>%E3%82%AD</text><text x='248' y='38'>3</text><text x='248' y='58'>%E3%83%A9</text><text x='248' y='78'>%E3%82%B5</text><text x='248' y='98'>%E3%83%9F</text><text x='248' y='118'>2</text><text x='248' y='138'>%E3%83%A0</text><text x='248' y='158'>%E3%83%84</text><text x='248' y='178'>0</text><text x='248' y='198'>%E3%82%A2</text><text x='248' y='218'>5</text><text x='272' y='18'>%E3%83%8D</text><text x='272' y='38'>%E3%82%B7</text><text x='272' y='58'>7</text><text x='272' y='78'>%E3%83%92</text><text x='296' y='18'>4</text><text x='296' y='38'>%E3%83%A0</text><text x='296' y='58'>%E3%83%A9</text><text x='296' y='78'>1</text><text x='296' y='98'>%E3%83%9F</text><text x='296' y='118'>%E3%82%AD</text><text x='8' y='328'>%E3%83%A0</text><text x='8' y='348'>%E3%83%9F</text><text x='8' y='368'>%E3%82%A2</text><text x='8' y='388'>3</text><text x='32' y='328'>%E3%83%8D</text><text x='32' y='348'>%E3%82%B7</text><text x='32' y='368'>5</text><text x='32' y='388'>%E3%83%84</text><text x='32' y='408'>%E3%82%B5</text><text x='32' y='428'>%E3%83%A9</text><text x='32' y='448'>0</text><text x='32' y='468'>%E3%83%92</text><text x='32' y='488'>%E3%83%A0</text><text x='32' y='508'>4</text><text x='104' y='328'>2</text><text x='104' y='348'>%E3%83%A9</text><text x='104' y='368'>%E3%82%AD</text><text x='104' y='388'>%E3%83%9F</text><text x='104' y='408'>%E3%82%A2</text><text x='104' y='428'>9</text><text x='104' y='448'>%E3%83%84</text><text x='128' y='328'>%E3%83%A0</text><text x='128' y='348'>3</text><text x='128' y='368'>%E3%83%92</text><text x='128' y='388'>%E3%82%B7</text><text x='152' y='328'>%E3%83%8D</text><text x='152' y='348'>%E3%83%9F</text><text x='152' y='368'>0</text><text x='152' y='388'>%E3%82%B5</text><text x='152' y='408'>%E3%83%A9</text><text x='152' y='428'>%E3%82%AD</text><text x='152' y='448'>7</text><text x='152' y='468'>%E3%83%84</text><text x='152' y='488'>%E3%82%A2</text><text x='224' y='328'>%E3%82%A2</text><text x='224' y='348'>%E3%83%92</text><text x='248' y='328'>4</text><text x='248' y='348'>%E3%83%A0</text><text x='248' y='368'>%E3%83%9F</text><text x='248' y='388'>%E3%82%B7</text><text x='248' y='408'>5</text><text x='248' y='428'>%E3%83%A9</text><text x='248' y='448'>%E3%83%84</text><text x='248' y='468'>0</text><text x='248' y='488'>%E3%82%AD</text><text x='248' y='508'>3</text><text x='248' y='528'>%E3%83%8D</text><text x='248' y='548'>2</text><text x='272' y='328'>%E3%82%B5</text><text x='272' y='348'>%E3%83%92</text><text x='272' y='368'>1</text></g></svg>");
    background-repeat: repeat;
    background-size: 320px 560px;
    opacity: 0.22;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 95%);
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 95%);
  }
  :global(.dark) .mission-matrix {
