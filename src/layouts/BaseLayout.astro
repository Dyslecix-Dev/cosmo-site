---
import { Font } from "astro:assets";

import Footer from "@/components/Footer.astro";
import KoFiPopover from "@/components/KoFiPopover.astro";
import Navbar from "@/components/Navbar.astro";
import SEO from "@/components/SEO.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const { title, description, image, canonicalURL, ogType, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} image={image} canonicalURL={canonicalURL} ogType={ogType} noindex={noindex} />
    <Font cssVariable="--font-space-mono" preload />
    <Font cssVariable="--font-roboto-mono" preload />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f0f0f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#142e38" media="(prefers-color-scheme: dark)" />
    <meta name="google-site-verification" content="RsA48Xbr19ZDvfP7rAMGyUXpFFvWgHH8_VEkOwgS79I" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Cosmo",
      "url": Astro.site?.toString(),
      "inLanguage": "en",
    })} />
    <slot name="head" />
    <script is:inline src="/theme.js"></script>
    <script>
      import { animate } from "motion";
      import { isMotionDisabled } from "@/lib/motion";

      document.addEventListener("pagereveal", () => {
        if (isMotionDisabled()) return;
        const burst = document.getElementById("vt-burst");
        if (!burst) return;
        animate(
          burst,
          { opacity: [0.85, 0], scale: [0.65, 1.7] },
          { duration: 0.7, ease: [0.22, 1, 0.36, 1] },
        );
      });
    </script>
  </head>
  <body class="min-h-screen bg-brand-quaternary dark:bg-brand-primary text-brand-primary dark:text-brand-quaternary antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-60 focus:rounded-md focus:bg-brand-primary focus:px-4 focus:py-2 focus:text-brand-quaternary dark:focus:bg-brand-quaternary dark:focus:text-brand-primary"
    >
      Skip to main content
    </a>
    <Navbar />
    <slot />
    <Footer />
    <KoFiPopover />
    <div id="vt-burst" aria-hidden="true" class="pointer-events-none fixed inset-0 z-[9999] opacity-0" style="background: radial-gradient(circle at 50% 45%, oklch(76% 0.09 188 / 0.55) 0%, transparent 65%);"></div>
    <script is:inline defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "2ac3323fca1d4fa3afcd3f6a28f5510e"}'></script>
  </body>
</html>
