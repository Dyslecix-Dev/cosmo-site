---
import { Font, Image } from "astro:assets";

import iconDark from "@/assets/icon-dark.png";
import iconLight from "@/assets/icon-light.png";
import Footer from "@/components/Footer.astro";
import KoFiPopover from "@/components/KoFiPopover.astro";
import Navbar from "@/components/Navbar.astro";
import NoCookieBanner from "@/components/NoCookieBanner.astro";
import SEO from "@/components/SEO.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const { title, description, image, canonicalURL, ogType, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} image={image} canonicalURL={canonicalURL} ogType={ogType} noindex={noindex} />
    <Font cssVariable="--font-space-mono" preload />
    <Font cssVariable="--font-roboto-mono" preload />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f0f0f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#142e38" media="(prefers-color-scheme: dark)" />
    <meta name="google-site-verification" content="RsA48Xbr19ZDvfP7rAMGyUXpFFvWgHH8_VEkOwgS79I" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Cosmo",
      "url": Astro.site?.toString(),
      "inLanguage": "en",
    })} />
    <slot name="head" />
    <script is:inline src="/theme.js"></script>
    <script is:inline>
      try {
        if (sessionStorage.getItem("page-curtain:incoming") === "1") {
          document.documentElement.classList.add("curtain-active");
        }
      } catch (_) {}
    </script>
    <script>
      import { animate } from "motion";
      import { isMotionDisabled } from "@/lib/motion";

      document.addEventListener("pagereveal", () => {
        if (isMotionDisabled()) return;
        const burst = document.getElementById("vt-burst");
        if (!burst) return;
        animate(
          burst,
          { opacity: [0.85, 0], scale: [0.65, 1.7] },
          { duration: 0.7, ease: [0.22, 1, 0.36, 1] },
        );
      });
    </script>
  </head>
  <body class="min-h-screen bg-brand-quaternary dark:bg-brand-primary text-brand-primary dark:text-brand-quaternary antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-60 focus:rounded-md focus:bg-brand-primary focus:px-4 focus:py-2 focus:text-brand-quaternary dark:focus:bg-brand-quaternary dark:focus:text-brand-primary"
    >
      Skip to main content
    </a>
    <div id="page-curtain" class="page-curtain" aria-hidden="true">
      <div class="page-curtain-layer page-curtain-layer-1"></div>
      <div class="page-curtain-layer page-curtain-layer-2"></div>
      <div class="page-curtain-layer page-curtain-layer-3"></div>
      <div class="page-curtain-content">
        <Image src={iconDark} alt="" loading="eager" class="page-curtain-icon page-curtain-icon-light-mode" />
        <Image src={iconLight} alt="" loading="eager" class="page-curtain-icon page-curtain-icon-dark-mode" />
      </div>
    </div>
    <Navbar />
    <slot />
    <Footer />
    <KoFiPopover />
    <NoCookieBanner />
    <script is:inline>
      (() => {
        const curtain = document.getElementById("page-curtain");
        if (!curtain) return;

        const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
        const incoming = sessionStorage.getItem("page-curtain:incoming") === "1";
        sessionStorage.removeItem("page-curtain:incoming");

        const SWEEP_MS = 1400 + 360;
        const ICON_FADE_MS = 280 + 380;

        if (incoming && !reduce) {
          curtain.dataset.state = "closed";
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              curtain.dataset.state = "opening";
              document.documentElement.classList.remove("curtain-active");
              setTimeout(() => {
                curtain.dataset.state = "idle";
              }, SWEEP_MS + 60);
            });
          });
        } else {
          curtain.dataset.state = "idle";
          document.documentElement.classList.remove("curtain-active");
        }

        if (reduce) return;

        const isInternalLink = (a) => {
          if (!a || a.target === "_blank" || a.hasAttribute("download")) return false;
          const href = a.getAttribute("href");
          if (!href || href.startsWith("#") || href.startsWith("mailto:") || href.startsWith("tel:")) return false;
          try {
            const url = new URL(a.href, window.location.href);
            if (url.origin !== window.location.origin) return false;

            if (url.pathname === window.location.pathname && url.search === window.location.search) {
              return false;
            }
            return true;
          } catch {
            return false;
          }
        };

        document.addEventListener("click", (e) => {
          if (e.defaultPrevented || e.button !== 0) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const a = e.target.closest?.("a[href]");
          if (!a || !isInternalLink(a)) return;

          e.preventDefault();
          const href = a.href;
          sessionStorage.setItem("page-curtain:incoming", "1");

          document.documentElement.classList.add("curtain-active");
          curtain.dataset.state = "closing";

          const minCover = SWEEP_MS + ICON_FADE_MS;
          setTimeout(() => {
            window.location.assign(href);
          }, minCover);
        });

        window.addEventListener("pageshow", (e) => {
          if (e.persisted) {
            curtain.dataset.state = "idle";
            document.documentElement.classList.remove("curtain-active");
            sessionStorage.removeItem("page-curtain:incoming");
          }
        });
      })();
    </script>
    <script is:inline defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "2ac3323fca1d4fa3afcd3f6a28f5510e"}'></script>
  </body>
</html>
