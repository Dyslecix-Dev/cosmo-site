---
import { Image } from "astro:assets";
import iconDark from "@/assets/icon-dark.png";
import iconLight from "@/assets/icon-light.png";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Page not found" description="The page you're looking for doesn't exist." noindex>
  <main id="main" class="mx-auto flex min-h-[80vh] max-w-2xl flex-col items-center justify-center px-6 py-24 pt-32 text-center">
    <Image src={iconLight} alt="" class="h-40 w-auto sm:h-52 dark:hidden" />
    <Image src={iconDark} alt="" class="h-40 w-auto sm:h-52 hidden dark:block" />
    <p class="mt-8 text-5xl font-bold tracking-tight text-brand-primary dark:text-brand-quaternary sm:text-6xl">404</p>
    <h1 class="mt-4 text-2xl font-bold tracking-tight text-brand-primary dark:text-brand-quaternary sm:text-3xl">Lost in space</h1>
    <p class="mt-4 text-lg text-brand-secondary dark:text-brand-tertiary">The page you're looking for has drifted out of orbit.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href="/" class="rounded-md bg-brand-tertiary px-5 py-2.5 text-sm font-semibold text-brand-primary transition hover:bg-brand-quaternary border-2 border-brand-tertiary">Back to home</a>
      <a
        href="/docs/getting-started"
        class="rounded-md border border-brand-secondary/50 dark:border-brand-tertiary/50 px-5 py-2.5 text-sm font-semibold text-brand-primary dark:text-brand-quaternary transition hover:bg-brand-primary/10 dark:hover:bg-brand-quaternary/10"
        >Read the docs</a
      >
    </div>
  </main>
</BaseLayout>
