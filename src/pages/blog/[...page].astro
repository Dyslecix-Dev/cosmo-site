---
import { type CollectionEntry, getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import EntryCard from "@/components/blog/EntryCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const entries = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(entries, { pageSize: 6 });
};

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;

const allEntries = await getCollection("blog", ({ data }) => !data.draft);
const tags = new Set<string>();
for (const entry of allEntries) {
  for (const tag of entry.data.tags ?? []) {
    tags.add(tag);
  }
}
const sortedTags = Array.from(tags).sort();
---

<BaseLayout title="Blog" description="Latest posts from the cosmo example blog.">
  <main id="main" class="mx-auto max-w-6xl px-6 py-16 max-sm:pt-6">
    <div class="mb-12 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <div>
        <h1 class="text-4xl font-bold tracking-tight">Blog</h1>
        <p class="mt-2 text-brand-secondary dark:text-brand-tertiary">Page {page.currentPage} of {page.lastPage}</p>
      </div>
      <div class="flex flex-wrap gap-2">
        {
          sortedTags.map((tag) => (
            <a
              href={`/blog/tags/${tag}`}
              class="rounded-md border border-brand-tertiary/50 dark:border-brand-secondary/50 px-3 py-1 text-sm font-medium text-brand-primary dark:text-brand-quaternary hover:bg-brand-tertiary/15 dark:hover:bg-brand-secondary/15"
            >
              {tag}
            </a>
          ))
        }
      </div>
    </div>

    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        page.data.map((entry) => (
          <li>
            <EntryCard entry={entry} />
          </li>
        ))
      }
    </ul>

    <nav class="mt-12 flex items-center justify-between" aria-label="Pagination">
      {page.url.prev ? (
        <a
          href={page.url.prev}
          class="rounded-md border border-brand-tertiary/50 dark:border-brand-secondary/50 px-4 py-2 text-sm font-medium text-brand-primary dark:text-brand-quaternary hover:bg-brand-tertiary/15 dark:hover:bg-brand-secondary/15"
        >
          ← Previous
        </a>
      ) : (
        <span
          class="rounded-md border border-brand-tertiary/50 dark:border-brand-secondary/50 px-4 py-2 text-sm font-medium text-brand-secondary/50 dark:text-brand-tertiary/50"
          aria-hidden="true"
        >
          ← Previous
        </span>
      )}

      <ol class="flex items-center gap-2">
        {
          Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => {
            const href = n === 1 ? "/blog" : `/blog/${n}`;
            const isCurrent = n === page.currentPage;
            return (
              <li>
                <a
                  href={href}
                  aria-current={isCurrent ? "page" : undefined}
                  class:list={["flex h-9 w-9 items-center justify-center rounded-md text-sm font-medium", isCurrent ? "bg-brand-primary dark:bg-brand-quaternary text-brand-quaternary dark:text-brand-primary" : "text-brand-primary dark:text-brand-quaternary hover:bg-brand-tertiary/25 dark:hover:bg-brand-secondary/25"]}
                >
                  {n}
                </a>
              </li>
            );
          })
        }
      </ol>

      {page.url.next ? (
        <a
          href={page.url.next}
          class="rounded-md border border-brand-tertiary/50 dark:border-brand-secondary/50 px-4 py-2 text-sm font-medium text-brand-primary dark:text-brand-quaternary hover:bg-brand-tertiary/15 dark:hover:bg-brand-secondary/15"
        >
          Next →
        </a>
      ) : (
        <span
          class="rounded-md border border-brand-tertiary/50 dark:border-brand-secondary/50 px-4 py-2 text-sm font-medium text-brand-secondary/50 dark:text-brand-tertiary/50"
          aria-hidden="true"
        >
          Next →
        </span>
      )}
    </nav>
  </main>
</BaseLayout>
