---
import { type CollectionEntry, getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BlogPost from "@/layouts/BlogPost.astro";
import { readingTime } from "@/lib/reading-time";
import { relatedEntries } from "@/lib/related-entries";

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: entries[i + 1] ?? null,
      next: entries[i - 1] ?? null,
      related: relatedEntries(entry, entries),
    },
  }));
};

interface Props {
  entry: CollectionEntry<"blog">;
  prev: CollectionEntry<"blog"> | null;
  next: CollectionEntry<"blog"> | null;
  related: CollectionEntry<"blog">[];
}

const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await render(entry);
const minutesToRead = readingTime(entry.body ?? "");
---

<BlogPost entry={entry} headings={headings} minutesToRead={minutesToRead} prev={prev} next={next} related={related}>
  <Content />
</BlogPost>
