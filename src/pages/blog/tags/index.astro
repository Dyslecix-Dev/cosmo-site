---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const entries = await getCollection("blog", ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const entry of entries) {
  for (const tag of entry.data.tags ?? []) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

const tags = Array.from(counts.entries()).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="All tags" description="Browse blog posts by tag.">
  <main id="main" class="mx-auto max-w-4xl px-6 py-16 max-sm:pt-6">
    <header class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight">Tags</h1>
      <p class="mt-2 text-brand-secondary dark:text-brand-tertiary">Browse posts by tag.</p>
    </header>

    <ul class="flex flex-wrap gap-3">
      {
        tags.map(([tag, count]) => (
          <li>
            <a
              href={`/blog/tags/${tag}`}
              class="inline-flex items-center gap-2 rounded-full border border-brand-tertiary/40 dark:border-brand-secondary/40 bg-brand-quaternary dark:bg-brand-primary px-4 py-1.5 text-sm font-medium text-brand-primary dark:text-brand-quaternary transition hover:border-brand-tertiary dark:hover:border-brand-secondary hover:bg-brand-tertiary/15 dark:hover:bg-brand-secondary/15"
            >
              <span>{tag}</span>
              <span class="rounded-full bg-brand-tertiary/25 dark:bg-brand-secondary/25 px-2 py-0.5 text-xs text-brand-primary dark:text-brand-quaternary">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
