---
import { getCollection, render } from "astro:content";
import DocBackground from "@/components/docs/DocBackground.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { themeForDoc } from "@/lib/doc-themes";

export async function getStaticPaths() {
  const docs = (await getCollection("docs")).filter((entry) => !entry.data.draft);

  const sorted = [...docs].sort((a, b) => {
    const aHas = a.data.order !== undefined;
    const bHas = b.data.order !== undefined;
    if (aHas && bHas) return (a.data.order as number) - (b.data.order as number);
    if (aHas) return -1;
    if (bHas) return 1;
    return a.data.title.localeCompare(b.data.title);
  });

  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: i > 0 ? sorted[i - 1] : null,
      next: i < sorted.length - 1 ? sorted[i + 1] : null,
      position: i + 1,
      total: sorted.length,
    },
  }));
}

const { entry, prev, next, position, total } = Astro.props;
const { Content, headings } = await render(entry);

const tocFlat = headings.filter((h) => h.depth === 2 || h.depth === 3);
type TocSection = { slug: string; text: string; children: { slug: string; text: string }[] };
const tocSections: TocSection[] = [];
for (const h of tocFlat) {
  if (h.depth === 2) {
    tocSections.push({ slug: h.slug, text: h.text, children: [] });
  } else if (h.depth === 3) {
    if (tocSections.length === 0) {
      tocSections.push({ slug: "", text: "", children: [] });
    }
    tocSections[tocSections.length - 1].children.push({ slug: h.slug, text: h.text });
  }
}
const tocHasGrouping = tocSections.some((s) => s.children.length > 0);
const theme = themeForDoc(entry.id);
const editUrl = `https://github.com/DyslecixDev/cosmo-site/edit/main/${entry.filePath}`;

const canonicalURL = new URL(`/docs/${entry.id}/`, Astro.site).toString();

const updatedISO = entry.data.updatedDate.toISOString();
const updatedLabel = entry.data.updatedDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: entry.data.title,
  ...(entry.data.description ? { description: entry.data.description } : {}),
  url: canonicalURL,
  inLanguage: "en",
  dateModified: updatedISO,
  author: {
    "@type": "Person",
    name: "Christian Demesa",
    sameAs: ["https://github.com/DyslecixDev", "https://x.com/DyslecixDev", "https://www.instagram.com/dyslecixdev/"],
  },
  publisher: { "@type": "Organization", name: "Cosmo" },
  mainEntityOfPage: canonicalURL,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Docs", item: new URL("/docs/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: entry.data.title, item: canonicalURL },
  ],
};
---

<BaseLayout title={entry.data.title} description={entry.data.description} ogType="article" image={`/open-graph/${entry.id}.png`}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <DocBackground theme={theme} />
  <main id="main" class="relative isolate overflow-x-clip pt-32 sm:pt-36 pb-24">

    <div class="mx-auto w-full max-w-6xl px-6 sm:px-10">
      <header class="doc-reveal rounded-2xl border border-brand-primary/15 dark:border-brand-quaternary/15 bg-brand-quaternary/25 dark:bg-brand-primary/10 relative panel-blur shadow-[0_8px_30px_rgba(0,0,0,0.08)] p-6 sm:p-10">
        <a href="/docs" data-all-guides-link class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-brand-tertiary hover:text-brand-primary dark:hover:text-brand-quaternary transition group">
          <span aria-hidden="true" class="all-guides-arrow">&larr;</span>
          <span>All guides</span>
        </a>

        <div class="mt-6 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.2em] text-brand-tertiary">
          <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-full bg-brand-tertiary shadow-[0_0_10px_currentColor]"></span>
          <span>Briefing {String(position).padStart(2, "0")} of {String(total).padStart(2, "0")}</span>
        </div>

        <h1 class="mt-4 font-heading font-bold tracking-tight leading-[0.95] text-[clamp(2.25rem,6vw,4.5rem)] text-brand-primary dark:text-brand-quaternary">
          {entry.data.title}
        </h1>
        {entry.data.description && (
          <p class="mt-5 max-w-2xl text-lg sm:text-xl text-brand-tertiary">
            {entry.data.description}
          </p>
        )}

        <p class="mt-6 font-mono text-xs uppercase tracking-[0.2em]/80 text-brand-tertiary/80">
          Last updated <time datetime={updatedISO}>{updatedLabel}</time>
        </p>
      </header>

      <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_240px]">
        <article class="doc-reveal min-w-0 rounded-2xl border border-brand-primary/15 dark:border-brand-quaternary/15 bg-brand-quaternary/25 dark:bg-brand-primary/10 relative panel-blur shadow-[0_8px_30px_rgba(0,0,0,0.08)] p-6 sm:p-10">
          <div class="doc-prose">
            <Content />
          </div>

          <div class="mt-12 border-t border-brand-primary/15 dark:border-brand-quaternary/15 pt-6">
            <a
              href={editUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-brand-tertiary hover:text-brand-primary dark:hover:text-brand-quaternary transition"
            >
              <span>Edit this page on GitHub</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          {(prev || next) && (
            <nav class="mt-6 grid gap-4 border-t border-brand-primary/15 dark:border-brand-quaternary/15 pt-6 sm:mt-12 sm:pt-8 sm:grid-cols-2 lg:hidden">
              <div>
                {prev && (
                  <a
                    href={`/docs/${prev.id}`}
                    class="group block rounded-2xl border border-brand-primary/15 dark:border-brand-quaternary/15 bg-brand-quaternary/25 dark:bg-brand-primary/10 relative panel-blur px-4 py-4 transition hover:border-brand-primary/35 dark:hover:border-brand-quaternary/35"
                  >
                    <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-brand-tertiary">
                      &larr; Previous
                    </span>
                    <span class="mt-1 block font-medium text-brand-primary dark:text-brand-quaternary">
                      {prev.data.title}
                    </span>
                  </a>
                )}
              </div>
              <div class="sm:text-right">
                {next && (
                  <a
                    href={`/docs/${next.id}`}
                    class="group block rounded-2xl border border-brand-primary/15 dark:border-brand-quaternary/15 bg-brand-quaternary/25 dark:bg-brand-primary/10 relative panel-blur px-4 py-4 transition hover:border-brand-primary/35 dark:hover:border-brand-quaternary/35"
                  >
                    <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-brand-tertiary">
                      Next &rarr;
                    </span>
                    <span class="mt-1 block font-medium text-brand-primary dark:text-brand-quaternary">
                      {next.data.title}
                    </span>
                  </a>
                )}
              </div>
            </nav>
          )}
        </article>

        {tocFlat.length > 0 && (
          <aside class="doc-reveal hidden lg:block">
            <div class="sticky top-32 rounded-2xl border border-brand-primary/15 dark:border-brand-quaternary/15 bg-brand-quaternary/25 dark:bg-brand-primary/10 panel-blur shadow-[0_8px_30px_rgba(0,0,0,0.08)] p-5">
              <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-brand-tertiary">
                On this page
              </div>
              <ul class="mt-3 space-y-1.5 border-l border-brand-primary/15 dark:border-brand-quaternary/15">
                {tocSections.map((section) => (
                  <li>
                    {section.children.length > 0 && tocHasGrouping ? (
                      <div class="toc-section" data-toc-section>
                        <div class="toc-summary flex items-center gap-2 border-l-2 -ml-px pl-3 pr-2 py-1 text-sm border-transparent text-brand-tertiary">
                          {section.slug ? (
                            <a
                              href={`#${section.slug}`}
                              data-toc-link
                              data-toc-target={section.slug}
                              class="flex-1 min-w-0 hover:text-brand-primary dark:hover:text-brand-quaternary transition"
                            >
                              {section.text}
                            </a>
                          ) : (
                            <span class="flex-1 min-w-0 font-mono text-[10px] uppercase tracking-[0.2em]">Sections</span>
                          )}
                          <button
                            type="button"
                            data-toc-toggle
                            aria-expanded="false"
                            aria-label="Toggle section"
                            class="toc-toggle shrink-0 inline-flex items-center justify-center w-5 h-5 cursor-pointer hover:text-brand-primary dark:hover:text-brand-quaternary transition"
                          >
                            <span aria-hidden="true" class="toc-caret text-xs leading-none transition-transform">&#9656;</span>
                          </button>
                        </div>
                        <div class="toc-body">
                          <ul class="space-y-1.5 overflow-hidden">
                            {section.children.map((child) => (
                              <li>
                                <a
                                  href={`#${child.slug}`}
                                  data-toc-link
                                  data-toc-target={child.slug}
                                  class="block border-l-2 -ml-px pl-6 py-1 text-sm transition border-transparent text-brand-tertiary hover:text-brand-primary dark:hover:text-brand-quaternary"
                                >
                                  {child.text}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    ) : (
                      <a
                        href={`#${section.slug}`}
                        data-toc-link
                        data-toc-target={section.slug}
                        class="block border-l-2 -ml-px pl-3 py-1 text-sm transition border-transparent text-brand-tertiary hover:text-brand-primary dark:hover:text-brand-quaternary"
                      >
                        {section.text}
                      </a>
                    )}
                  </li>
                ))}
              </ul>

              {(prev || next) && (
                <div class="mt-8 space-y-6 border-t border-brand-primary/15 dark:border-brand-quaternary/15 pt-6 text-sm">
                  {prev && (
                    <a href={`/docs/${prev.id}`} class="block group">
                      <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-brand-tertiary">
                        &larr; Previous
                      </span>
                      <span class="mt-0.5 block text-brand-primary/80 dark:text-brand-quaternary/80 group-hover:text-brand-primary dark:group-hover:text-brand-quaternary transition">
                        {prev.data.title}
                      </span>
                    </a>
                  )}
                  {next && (
                    <a href={`/docs/${next.id}`} class="block group">
                      <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-brand-tertiary">
                        Next &rarr;
                      </span>
                      <span class="mt-0.5 block text-brand-primary/80 dark:text-brand-quaternary/80 group-hover:text-brand-primary dark:group-hover:text-brand-quaternary transition">
                        {next.data.title}
                      </span>
                    </a>
                  )}
                </div>
              )}
            </div>
          </aside>
        )}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .toc-toggle { background: none; border: 0; padding: 0; color: inherit; }
  .toc-section .toc-caret { transition: transform 220ms ease; display: inline-block; }
  .toc-section[data-open="true"] .toc-caret { transform: rotate(90deg); }

  .toc-body {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 240ms ease, opacity 180ms ease;
  }
  .toc-body > ul {
    min-height: 0;
  }
  .toc-section[data-open="true"] > .toc-body {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-section .toc-caret,
    .toc-body {
      transition: none;
    }
  }
</style>


<script>
  import { animate, stagger } from "motion";
  import { isMotionDisabled, MOTION_EVENT } from "@/lib/motion";

  const cleanups: Array<() => void> = [];

  function reset() {
    while (cleanups.length) {
      try { cleanups.pop()?.(); } catch { /* fail silently */ }
    }
  }

  function initDocDetail() {
    reset();
    const reduce = isMotionDisabled();

    const intro = document.querySelectorAll<HTMLElement>(".doc-reveal");
    if (intro.length) {
      if (reduce) {
        for (const el of intro) el.style.opacity = "1";
      } else {
        animate(
          intro,
          { opacity: [0, 1], transform: ["translateY(18px)", "translateY(0)"] },
          { duration: 0.7, delay: stagger(0.07, { startDelay: 0.1 }), ease: [0.22, 1, 0.36, 1] },
        );
      }
    }

    initScrollSpy();
    initTocSmoothScroll();
    initAllGuidesLink();
    initTocToggles();
  }

  function initTocToggles() {
    const toggles = document.querySelectorAll<HTMLButtonElement>("[data-toc-toggle]");
    for (const btn of toggles) {
      const section = btn.closest<HTMLElement>("[data-toc-section]");
      if (!section) continue;
      const onClick = () => {
        const open = section.dataset.open === "true";
        section.dataset.open = open ? "false" : "true";
        btn.setAttribute("aria-expanded", open ? "false" : "true");
      };
      btn.addEventListener("click", onClick);
      cleanups.push(() => btn.removeEventListener("click", onClick));
    }
  }

  function initAllGuidesLink() {
    const reduce = isMotionDisabled();
    const link = document.querySelector<HTMLAnchorElement>("[data-all-guides-link]");
    if (!link) return;

    const arrow = link.querySelector<HTMLElement>(".all-guides-arrow");
    if (!arrow) return;

    const onHoverStart = () => {
      if (reduce) return;
      animate(
        arrow,
        { transform: ["translateX(0)", "translateX(-4px)", "translateX(0)"] },
        { duration: 0.6, ease: [0.34, 1.56, 0.64, 1] }
      );
    };

    link.addEventListener("mouseenter", onHoverStart);
    cleanups.push(() => link.removeEventListener("mouseenter", onHoverStart));
  }

  let setActiveExternal: ((slug: string | null) => void) | null = null;

  function initScrollSpy() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
    if (!links.length) return;

    const headings = links
      .map((link) => {
        const slug = link.dataset.tocTarget;
        return slug ? document.getElementById(slug) : null;
      })
      .filter((el): el is HTMLElement => el !== null);

    if (!headings.length) return;

    const setActive = (slug: string | null) => {
      for (const link of links) {
        link.dataset.active = String(slug !== null && link.dataset.tocTarget === slug);
      }
    };
    setActiveExternal = setActive;

    const update = () => {
      if (scrollLock) {
        setActive(scrollLock.slug);
        return;
      }
      const atBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      if (atBottom) {
        setActive(headings[headings.length - 1].id);
        return;
      }
      const offset = 140;
      let active = headings[0];
      for (const h of headings) {
        if (h.getBoundingClientRect().top - offset <= 0) {
          active = h;
        } else {
          break;
        }
      }
      setActive(active.id);
    };

    update();
    let raf = 0;
    const onScroll = () => {
      if (raf) return;
      raf = window.requestAnimationFrame(() => {
        raf = 0;
        update();
      });
    };
    const onUserScroll = () => {
      scrollLock = null;
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    window.addEventListener("wheel", onUserScroll, { passive: true });
    window.addEventListener("touchstart", onUserScroll, { passive: true });
    window.addEventListener("keydown", onUserScroll);
    cleanups.push(() => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
      window.removeEventListener("wheel", onUserScroll);
      window.removeEventListener("touchstart", onUserScroll);
      window.removeEventListener("keydown", onUserScroll);
      setActiveExternal = null;
      if (raf) window.cancelAnimationFrame(raf);
    });
  }

  let scrollLock: { slug: string } | null = null;

  function initTocSmoothScroll() {
    const reduce = isMotionDisabled();
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
    for (const link of links) {
      const onClick = (event: MouseEvent) => {
        const slug = link.dataset.tocTarget;
        if (!slug) return;
        const target = document.getElementById(slug);
        if (!target) return;
        event.preventDefault();
        const offset = 110;
        const targetY = target.getBoundingClientRect().top + window.scrollY - offset;
        scrollLock = { slug };
        setActiveExternal?.(slug);
        window.scrollTo({ top: targetY, behavior: reduce ? "auto" : "smooth" });
        history.replaceState(null, "", `#${slug}`);
      };
      link.addEventListener("click", onClick);
      cleanups.push(() => link.removeEventListener("click", onClick));
    }
  }

  initDocDetail();
  document.addEventListener("astro:page-load", initDocDetail);
  document.addEventListener(MOTION_EVENT, initDocDetail);
</script>
