---
import { getCollection, render } from "astro:content";
import DocBackground from "@/components/docs/DocBackground.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { themeForDoc } from "@/lib/doc-themes";

export async function getStaticPaths() {
  const docs = (await getCollection("docs")).filter((entry) => !entry.data.draft);

  const sorted = [...docs].sort((a, b) => {
    const aHas = a.data.order !== undefined;
    const bHas = b.data.order !== undefined;
    if (aHas && bHas) return (a.data.order as number) - (b.data.order as number);
    if (aHas) return -1;
    if (bHas) return 1;
    return a.data.title.localeCompare(b.data.title);
  });

  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: i > 0 ? sorted[i - 1] : null,
      next: i < sorted.length - 1 ? sorted[i + 1] : null,
      position: i + 1,
      total: sorted.length,
    },
  }));
}

const { entry, prev, next, position, total } = Astro.props;
const { Content, headings } = await render(entry);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const theme = themeForDoc(entry.id);
const editUrl = `https://github.com/Dyslecix-Dev/cosmo-site/edit/main/${entry.filePath}`;

const canonicalURL = new URL(`/docs/${entry.id}/`, Astro.site).toString();

const updatedISO = entry.data.updatedDate.toISOString();
const updatedLabel = entry.data.updatedDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: entry.data.title,
  ...(entry.data.description ? { description: entry.data.description } : {}),
  url: canonicalURL,
  inLanguage: "en",
  dateModified: updatedISO,
  author: {
    "@type": "Person",
    name: "Christian Demesa",
    sameAs: ["https://github.com/DyslecixDev", "https://x.com/DyslecixDev", "https://www.instagram.com/dyslecixdev/"],
  },
  publisher: { "@type": "Organization", name: "Cosmo" },
  mainEntityOfPage: canonicalURL,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Docs", item: new URL("/docs/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: entry.data.title, item: canonicalURL },
  ],
};
---

<BaseLayout title={entry.data.title} description={entry.data.description} ogType="article" image={`/${entry.id}-og-image.png`}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <DocBackground theme={theme} />
  <main id="main" class="relative isolate overflow-x-clip pt-32 sm:pt-36 pb-24">

    <div class="mx-auto w-full max-w-6xl px-6 sm:px-10">
      <header class="doc-reveal rounded-2xl border border-brand-primary/15 dark:border-brand-quaternary/15 bg-brand-quaternary/30 dark:bg-brand-primary/30 backdrop-blur-2xl shadow-[0_8px_30px_rgba(0,0,0,0.08)] p-6 sm:p-10">
        <a href="/docs" class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-brand-secondary dark:text-brand-tertiary hover:text-brand-primary dark:hover:text-brand-quaternary transition">
          <span aria-hidden="true">&larr;</span>
          <span>All guides</span>
        </a>

        <div class="mt-6 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.2em] text-brand-secondary dark:text-brand-tertiary">
          <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-full bg-brand-tertiary shadow-[0_0_10px_currentColor]"></span>
          <span>Briefing {String(position).padStart(2, "0")} of {String(total).padStart(2, "0")}</span>
        </div>

        <h1 class="mt-4 font-heading font-bold tracking-tight leading-[0.95] text-[clamp(2.25rem,6vw,4.5rem)] text-brand-primary dark:text-brand-quaternary">
          {entry.data.title}
        </h1>
        {entry.data.description && (
          <p class="mt-5 max-w-2xl text-lg sm:text-xl text-brand-secondary dark:text-brand-tertiary">
            {entry.data.description}
          </p>
        )}

        <p class="mt-6 font-mono text-xs uppercase tracking-[0.2em] text-brand-secondary/80 dark:text-brand-tertiary/80">
          Last updated <time datetime={updatedISO}>{updatedLabel}</time>
        </p>
      </header>

      <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_240px]">
        <article class="doc-reveal min-w-0 rounded-2xl border border-brand-primary/15 dark:border-brand-quaternary/15 bg-brand-quaternary/30 dark:bg-brand-primary/30 backdrop-blur-2xl shadow-[0_8px_30px_rgba(0,0,0,0.08)] p-6 sm:p-10">
          <div class="doc-prose">
            <Content />
          </div>

          <div class="mt-12 border-t border-brand-primary/15 dark:border-brand-quaternary/15 pt-6">
            <a
              href={editUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-brand-secondary dark:text-brand-tertiary hover:text-brand-primary dark:hover:text-brand-quaternary transition"
            >
              <span>Edit this page on GitHub</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          {(prev || next) && (
            <nav class="mt-12 grid gap-4 border-t border-brand-primary/15 dark:border-brand-quaternary/15 pt-8 sm:grid-cols-2 lg:hidden">
              <div>
                {prev && (
                  <a
                    href={`/docs/${prev.id}`}
                    class="group block rounded-2xl border border-brand-primary/15 dark:border-brand-quaternary/15 bg-brand-quaternary/30 dark:bg-brand-primary/30 backdrop-blur-2xl px-4 py-4 transition hover:border-brand-primary/35 dark:hover:border-brand-quaternary/35"
                  >
                    <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-brand-secondary dark:text-brand-tertiary">
                      &larr; Previous
                    </span>
                    <span class="mt-1 block font-medium text-brand-primary dark:text-brand-quaternary">
                      {prev.data.title}
                    </span>
                  </a>
                )}
              </div>
              <div class="sm:text-right">
                {next && (
                  <a
                    href={`/docs/${next.id}`}
                    class="group block rounded-2xl border border-brand-primary/15 dark:border-brand-quaternary/15 bg-brand-quaternary/30 dark:bg-brand-primary/30 backdrop-blur-2xl px-4 py-4 transition hover:border-brand-primary/35 dark:hover:border-brand-quaternary/35"
                  >
                    <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-brand-secondary dark:text-brand-tertiary">
                      Next &rarr;
                    </span>
                    <span class="mt-1 block font-medium text-brand-primary dark:text-brand-quaternary">
                      {next.data.title}
                    </span>
                  </a>
                )}
              </div>
            </nav>
          )}
        </article>

        {toc.length > 0 && (
          <aside class="doc-reveal hidden lg:block">
            <div class="sticky top-32 rounded-2xl border border-brand-primary/15 dark:border-brand-quaternary/15 bg-brand-quaternary/30 dark:bg-brand-primary/30 backdrop-blur-2xl shadow-[0_8px_30px_rgba(0,0,0,0.08)] p-5">
              <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-brand-secondary dark:text-brand-tertiary">
                On this page
              </div>
              <ul class="mt-3 space-y-1.5 border-l border-brand-primary/15 dark:border-brand-quaternary/15">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-toc-link
                      data-toc-target={h.slug}
                      class:list={[
                        "block border-l-2 -ml-px py-1 text-sm transition",
                        h.depth === 3 ? "pl-6" : "pl-3",
                        "border-transparent text-brand-secondary dark:text-brand-tertiary hover:text-brand-primary dark:hover:text-brand-quaternary",
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>

              {(prev || next) && (
                <div class="mt-8 space-y-6 border-t border-brand-primary/15 dark:border-brand-quaternary/15 pt-6 text-sm">
                  {prev && (
                    <a href={`/docs/${prev.id}`} class="block group">
                      <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-brand-secondary dark:text-brand-tertiary">
                        &larr; Previous
                      </span>
                      <span class="mt-0.5 block text-brand-primary/80 dark:text-brand-quaternary/80 group-hover:text-brand-primary dark:group-hover:text-brand-quaternary transition">
                        {prev.data.title}
                      </span>
                    </a>
                  )}
                  {next && (
                    <a href={`/docs/${next.id}`} class="block group">
                      <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-brand-secondary dark:text-brand-tertiary">
                        Next &rarr;
                      </span>
                      <span class="mt-0.5 block text-brand-primary/80 dark:text-brand-quaternary/80 group-hover:text-brand-primary dark:group-hover:text-brand-quaternary transition">
                        {next.data.title}
                      </span>
                    </a>
                  )}
                </div>
              )}
            </div>
          </aside>
        )}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .doc-reveal {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .doc-reveal {
      opacity: 1;
    }
  }
</style>


<script>
  import { animate, stagger } from "motion";
  import { isMotionDisabled, MOTION_EVENT } from "@/lib/motion";

  const cleanups: Array<() => void> = [];

  function reset() {
    while (cleanups.length) {
      try { cleanups.pop()?.(); } catch { /* fail silently */ }
    }
  }

  function initDocDetail() {
    reset();
    const reduce = isMotionDisabled();

    const intro = document.querySelectorAll<HTMLElement>(".doc-reveal");
    if (intro.length) {
      if (reduce) {
        for (const el of intro) el.style.opacity = "1";
      } else {
        animate(
          intro,
          { opacity: [0, 1], transform: ["translateY(18px)", "translateY(0)"] },
          { duration: 0.7, delay: stagger(0.07, { startDelay: 0.1 }), ease: [0.22, 1, 0.36, 1] },
        );
      }
    }

    initScrollSpy();
    initTocSmoothScroll();
  }

  let setActiveExternal: ((slug: string | null) => void) | null = null;

  function initScrollSpy() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
    if (!links.length) return;

    const headings = links
      .map((link) => {
        const slug = link.dataset.tocTarget;
        return slug ? document.getElementById(slug) : null;
      })
      .filter((el): el is HTMLElement => el !== null);

    if (!headings.length) return;

    const setActive = (slug: string | null) => {
      for (const link of links) {
        link.dataset.active = String(slug !== null && link.dataset.tocTarget === slug);
      }
    };
    setActiveExternal = setActive;

    const update = () => {
      if (scrollLock) {
        setActive(scrollLock.slug);
        return;
      }
      const atBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      if (atBottom) {
        setActive(headings[headings.length - 1].id);
        return;
      }
      const offset = 140;
      let active = headings[0];
      for (const h of headings) {
        if (h.getBoundingClientRect().top - offset <= 0) {
          active = h;
        } else {
          break;
        }
      }
      setActive(active.id);
    };

    update();
    let raf = 0;
    const onScroll = () => {
      if (raf) return;
      raf = window.requestAnimationFrame(() => {
        raf = 0;
        update();
      });
    };
    const onUserScroll = () => {
      scrollLock = null;
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    window.addEventListener("wheel", onUserScroll, { passive: true });
    window.addEventListener("touchstart", onUserScroll, { passive: true });
    window.addEventListener("keydown", onUserScroll);
    cleanups.push(() => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
      window.removeEventListener("wheel", onUserScroll);
      window.removeEventListener("touchstart", onUserScroll);
      window.removeEventListener("keydown", onUserScroll);
      setActiveExternal = null;
      if (raf) window.cancelAnimationFrame(raf);
    });
  }

  let scrollLock: { slug: string } | null = null;

  function smoothScrollTo(targetY: number, duration = 800, onDone?: () => void) {
    const startY = window.scrollY;
    const distance = targetY - startY;
    if (Math.abs(distance) < 2) {
      onDone?.();
      return;
    }
    const start = performance.now();
    const html = document.documentElement;
    const prevBehavior = html.style.scrollBehavior;
    html.style.scrollBehavior = "auto";

    let cancelled = false;
    const onUserScroll = () => { cancelled = true; };
    window.addEventListener("wheel", onUserScroll, { passive: true, once: true });
    window.addEventListener("touchmove", onUserScroll, { passive: true, once: true });

    const finish = () => {
      html.style.scrollBehavior = prevBehavior;
      onDone?.();
    };

    const easeInOutCubic = (t: number) =>
      t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

    const step = (now: number) => {
      if (cancelled) {
        finish();
        return;
      }
      const elapsed = now - start;
      const t = Math.min(elapsed / duration, 1);
      window.scrollTo(0, startY + distance * easeInOutCubic(t));
      if (t < 1) window.requestAnimationFrame(step);
      else finish();
    };
    window.requestAnimationFrame(step);
  }

  function initTocSmoothScroll() {
    const reduce = isMotionDisabled();
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
    for (const link of links) {
      const onClick = (event: MouseEvent) => {
        const slug = link.dataset.tocTarget;
        if (!slug) return;
        const target = document.getElementById(slug);
        if (!target) return;
        event.preventDefault();
        const offset = 110;
        const targetY = target.getBoundingClientRect().top + window.scrollY - offset;
        scrollLock = { slug };
        setActiveExternal?.(slug);
        if (reduce) {
          window.scrollTo(0, targetY);
        } else {
          smoothScrollTo(targetY, 500);
        }
        history.replaceState(null, "", `#${slug}`);
      };
      link.addEventListener("click", onClick);
      cleanups.push(() => link.removeEventListener("click", onClick));
    }
  }

  initDocDetail();
  document.addEventListener("astro:page-load", initDocDetail);
  document.addEventListener(MOTION_EVENT, initDocDetail);
</script>
