      radial-gradient(1px 1px at 28% 64%, rgba(255, 255, 255, 0.6), transparent 60%),
      radial-gradient(1.5px 1.5px at 47% 18%, rgba(255, 255, 255, 0.9), transparent 60%),
      radial-gradient(1px 1px at 63% 42%, rgba(255, 255, 255, 0.5), transparent 60%),
      radial-gradient(1px 1px at 78% 78%, rgba(255, 255, 255, 0.7), transparent 60%),
      radial-gradient(1.5px 1.5px at 88% 30%, rgba(255, 255, 255, 0.8), transparent 60%),
      radial-gradient(1px 1px at 38% 86%, rgba(255, 255, 255, 0.5), transparent 60%),
      radial-gradient(1px 1px at 8% 70%, rgba(255, 255, 255, 0.6), transparent 60%),
      radial-gradient(1px 1px at 56% 8%, rgba(255, 255, 255, 0.7), transparent 60%);
