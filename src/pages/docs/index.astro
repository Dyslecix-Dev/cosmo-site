---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import constellation from "@/assets/constellation.png";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { themeForDoc } from "@/lib/doc-themes";

const docs = (await getCollection("docs")).filter((entry) => !entry.data.draft);
const sorted = [...docs].sort((a, b) => {
  const aHas = a.data.order !== undefined;
  const bHas = b.data.order !== undefined;
  if (aHas && bHas) return (a.data.order as number) - (b.data.order as number);
  if (aHas) return -1;
  if (bHas) return 1;
  return a.data.title.localeCompare(b.data.title);
});

const cards = sorted.map((entry, i) => ({
  entry,
  theme: themeForDoc(entry.id),
  index: i,
}));

const STAR_COUNT = 160;
const SPARKLE_COUNT = 48;

function seeded(i: number, salt: number) {
  const x = Math.sin(i * 928.371 + salt * 13.27) * 10000;
  return x - Math.floor(x);
}

const stars = Array.from({ length: STAR_COUNT }, (_, i) => {
  const top = seeded(i, 1) * 100;
  const left = seeded(i, 2) * 100;
  const size = 0.5 + seeded(i, 3) * 1.8;
  const opacity = 0.35 + seeded(i, 4) * 0.55;
  const twinkleDur = 2.5 + seeded(i, 5) * 5;
  const twinkleDelay = seeded(i, 6) * -8;
  return { top, left, size, opacity, twinkleDur, twinkleDelay };
});

const sparkles = Array.from({ length: SPARKLE_COUNT }, (_, i) => {
  const top = seeded(i, 11) * 100;
  const left = seeded(i, 12) * 100;
  const size = 0.7 + seeded(i, 13) * 1.4;
  const opacity = 0.3 + seeded(i, 14) * 0.45;
  const bobDur = 6 + seeded(i, 15) * 8;
  const bobDelay = seeded(i, 16) * -10;
  const spinDur = 14 + seeded(i, 17) * 16;
  const reverse = seeded(i, 18) > 0.5 ? "reverse" : "normal";
  return { top, left, size, opacity, bobDur, bobDelay, spinDur, reverse };
});
---

<BaseLayout title="Docs" description="Guides for building with the Cosmo Astro template — tokens, collections, SEO, deployment.">
  <main id="main" class="relative isolate overflow-x-clip pt-32 sm:pt-36 pb-24">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="docs-aurora docs-aurora-1"></div>
      <div class="docs-aurora docs-aurora-2"></div>
      <div class="docs-grid"></div>
      <div class="docs-starfield">
        {stars.map((s) => (
          <span
            class="doc-star"
            style={`top:${s.top}%;left:${s.left}%;width:${s.size}px;height:${s.size}px;--o:${s.opacity};animation-duration:${s.twinkleDur}s;animation-delay:${s.twinkleDelay}s;`}
          ></span>
        ))}
      </div>
      <Image src={constellation} alt="" class="docs-constellation" loading="lazy" decoding="async" />
      <div class="docs-sparkles">
        {sparkles.map((s) => (
          <span
            class="doc-sparkle"
            style={`top:${s.top}%;left:${s.left}%;font-size:${s.size}rem;--o:${s.opacity};--bob-d:${s.bobDur}s;--bob-delay:${s.bobDelay}s;--spin-d:${s.spinDur}s;--spin-dir:${s.reverse};`}
          >&#10022;</span>
        ))}
      </div>
    </div>

    <section class="mx-auto w-full max-w-6xl px-6 sm:px-10">
      <div class="docs-reveal flex items-center gap-3 font-mono text-xs uppercase tracking-[0.2em] text-brand-secondary dark:text-brand-tertiary">
        <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-full bg-brand-tertiary shadow-[0_0_10px_currentColor]"></span>
        <span>Star charts</span>
        <span aria-hidden="true">&middot;</span>
        <span>{cards.length} guides</span>
      </div>

      <h1 class="docs-reveal mt-6 font-heading font-bold tracking-tight leading-[0.9] text-[clamp(2.5rem,8vw,6rem)]">
        Mission briefings
      </h1>
      <p class="docs-reveal mt-6 max-w-2xl text-lg sm:text-xl text-brand-primary dark:text-brand-quaternary">
        Drift between systems at your own pace.
      </p>

      <ul class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {cards.map(({ entry, theme, index }) => (
          <li
            class="docs-card-reveal"
            style={`--reveal-delay:${index * 60}ms`}
          >
            <a
              href={`/docs/${entry.id}`}
              data-doc-card
              class:list={[
                "group relative block h-full overflow-hidden rounded-2xl border border-brand-primary/15 dark:border-brand-quaternary/15",
                "bg-brand-quaternary/40 dark:bg-brand-primary/40 backdrop-blur-md",
                "transition duration-300 hover:-translate-y-1 hover:border-brand-primary/35 dark:hover:border-brand-quaternary/35",
                "hover:shadow-[0_20px_60px_-15px_rgba(0,0,0,0.35)]",
              ]}
            >
              <div
                aria-hidden="true"
                class={`doc-preview doc-preview-${theme.key}`}
                style={`--c1:${theme.c1};--c2:${theme.c2};--c3:${theme.c3};`}
              >
                <span class="doc-preview-layer doc-preview-base"></span>
                <span class="doc-preview-layer doc-preview-accent"></span>
                <span class="doc-preview-layer doc-preview-stars"></span>
                <span class="doc-preview-vignette"></span>
              </div>

              <div class="relative z-10 flex h-full flex-col gap-4 p-6">
                <div class="flex items-center justify-between text-[10px] font-mono uppercase tracking-[0.18em] text-brand-secondary dark:text-brand-tertiary">
                  <span>{String((entry.data.order ?? index + 1)).padStart(2, "0")} &middot; {theme.label}</span>
                  <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
                </div>

                <h2 class="font-heading text-xl sm:text-2xl font-semibold leading-tight text-brand-primary dark:text-brand-quaternary">
                  {entry.data.title}
                </h2>

                {entry.data.description && (
                  <p class="text-sm text-brand-secondary dark:text-brand-tertiary leading-relaxed">
                    {entry.data.description}
                  </p>
                )}

                <span class="mt-auto inline-flex items-center gap-1.5 text-xs font-medium text-brand-primary dark:text-brand-quaternary">
                  <span class="opacity-70 group-hover:opacity-100 transition">Open guide</span>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  @property --ring-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 90deg;
  }

  .docs-reveal,
  .docs-card-reveal {
    opacity: 0;
  }

  .docs-aurora {
    position: absolute;
    border-radius: 9999px;
    filter: blur(100px) saturate(140%);
    opacity: 0.35;
    mix-blend-mode: multiply;
  }

  :where(.dark) .docs-aurora {
    opacity: 0.3;
    mix-blend-mode: screen;
  }

  .docs-aurora-1 {
    top: -15%;
    left: -10%;
    width: 50vw;
    height: 50vw;
    background: var(--color-brand-tertiary);
  }

  .docs-aurora-2 {
    bottom: -20%;
    right: -10%;
    width: 45vw;
    height: 45vw;
    background: var(--color-brand-secondary);
    animation: docs-aurora-drift 90s ease-in-out infinite;
  }

  .docs-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in oklch, var(--color-brand-primary) 5%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklch, var(--color-brand-primary) 5%, transparent) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at center top, black 30%, transparent 75%);
  }

  :where(.dark) .docs-grid {
    background-image:
      linear-gradient(to right, color-mix(in oklch, var(--color-brand-quaternary) 5%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklch, var(--color-brand-quaternary) 5%, transparent) 1px, transparent 1px);
  }

  .doc-preview {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    background: var(--c3);
  }

  .doc-preview-layer {
    position: absolute;
    inset: 0;
    display: block;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1), opacity 700ms ease;
  }

  .doc-preview-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 55%, color-mix(in oklch, var(--c3) 80%, black) 100%);
