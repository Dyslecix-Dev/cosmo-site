  }

  .group:hover .doc-preview-stars {
    transform: scale(1.06);
    opacity: 0.95;
  }

  .doc-preview-solar-system .doc-preview-base {
    background:
      radial-gradient(circle at 28% 58%, var(--c1) 0%, color-mix(in oklch, var(--c1) 60%, var(--c2)) 8%, var(--c2) 18%, transparent 38%),
      radial-gradient(circle at 28% 58%, color-mix(in oklch, var(--c2) 70%, transparent) 0%, transparent 55%),
      linear-gradient(135deg, color-mix(in oklch, var(--c3) 80%, var(--c2) 20%), var(--c3));
  }
  .doc-preview-solar-system .doc-preview-accent {
    background:
      radial-gradient(circle at 28% 58%, transparent 14%, color-mix(in oklch, var(--c1) 35%, transparent) 16%, transparent 22%),
      radial-gradient(circle at 28% 58%, transparent 26%, color-mix(in oklch, var(--c2) 25%, transparent) 28%, transparent 34%);
    mix-blend-mode: screen;
  }
  .group:hover .doc-preview-solar-system .doc-preview-accent {
    transform: scale(1.08);
  }

  .doc-preview-protoplanetary .doc-preview-base {
    background:
      radial-gradient(circle at 50% 60%, var(--c1) 0%, transparent 6%),
      radial-gradient(ellipse 60% 18% at 50% 60%, color-mix(in oklch, var(--c1) 50%, transparent) 0%, transparent 70%),
      radial-gradient(ellipse 80% 22% at 50% 60%, color-mix(in oklch, var(--c2) 40%, transparent) 0%, transparent 70%),
      linear-gradient(160deg, color-mix(in oklch, var(--c3) 70%, var(--c2) 30%), var(--c3));
  }
  .doc-preview-protoplanetary .doc-preview-accent {
    background:
      radial-gradient(ellipse 95% 26% at 50% 60%, transparent 60%, color-mix(in oklch, var(--c1) 25%, transparent) 70%, transparent 85%);
    mix-blend-mode: screen;
  }
  .group:hover .doc-preview-protoplanetary .doc-preview-accent {
    transform: rotate(-3deg) scale(1.04);
  }

  .doc-preview-asteroid-belt .doc-preview-base {
    background:
      radial-gradient(ellipse 120% 30% at 50% 55%, color-mix(in oklch, var(--c1) 40%, transparent) 0%, transparent 70%),
      linear-gradient(150deg, var(--c3) 0%, color-mix(in oklch, var(--c3) 70%, var(--c2) 30%) 100%);
  }
  .doc-preview-asteroid-belt .doc-preview-accent {
    background-image:
      radial-gradient(2px 2px at 10% 55%, var(--c1), transparent 70%),
      radial-gradient(2.5px 2.5px at 22% 48%, var(--c1), transparent 70%),
      radial-gradient(1.5px 1.5px at 33% 60%, var(--c2), transparent 70%),
      radial-gradient(2px 2px at 46% 52%, var(--c1), transparent 70%),
      radial-gradient(3px 3px at 58% 58%, var(--c1), transparent 70%),
      radial-gradient(1.5px 1.5px at 70% 50%, var(--c2), transparent 70%),
      radial-gradient(2px 2px at 82% 56%, var(--c1), transparent 70%),
      radial-gradient(2.5px 2.5px at 92% 50%, var(--c1), transparent 70%);
    opacity: 0.85;
  }
  .group:hover .doc-preview-asteroid-belt .doc-preview-accent {
    transform: translateX(-4%);
  }

  .doc-preview-nebula .doc-preview-base {
    background:
      radial-gradient(ellipse 60% 70% at 30% 40%, color-mix(in oklch, var(--c1) 70%, transparent) 0%, transparent 65%),
      radial-gradient(ellipse 70% 60% at 75% 65%, color-mix(in oklch, var(--c2) 65%, transparent) 0%, transparent 70%),
      radial-gradient(ellipse 50% 60% at 55% 30%, color-mix(in oklch, var(--c1) 40%, transparent) 0%, transparent 75%),
      linear-gradient(160deg, var(--c3), color-mix(in oklch, var(--c3) 60%, var(--c2) 40%));
    filter: saturate(115%);
  }
  .doc-preview-nebula .doc-preview-accent {
    background:
      radial-gradient(ellipse 35% 45% at 45% 55%, color-mix(in oklch, var(--c1) 55%, transparent) 0%, transparent 70%),
      radial-gradient(ellipse 30% 35% at 70% 35%, color-mix(in oklch, var(--c2) 50%, transparent) 0%, transparent 70%);
    mix-blend-mode: screen;
  }
  .group:hover .doc-preview-nebula .doc-preview-accent {
    transform: scale(1.1) translateX(2%);
  }

  .doc-preview-green-starfield .doc-preview-base {
    background:
      radial-gradient(circle at 50% 52%, color-mix(in oklch, var(--c1) 95%, white) 0%, transparent 3%),
      radial-gradient(circle at 50% 52%, color-mix(in oklch, var(--c2) 85%, transparent) 0%, color-mix(in oklch, var(--c2) 45%, transparent) 14%, transparent 32%),
      radial-gradient(circle at 50% 52%, color-mix(in oklch, var(--c2) 30%, transparent) 0%, transparent 50%),
      var(--c3);
    filter: saturate(140%);
  }
  .doc-preview-green-starfield .doc-preview-accent {
    background:
      conic-gradient(from 0deg at 50% 52%, transparent 0deg, rgba(0,0,0,0.55) 25deg, transparent 55deg, transparent 115deg, rgba(0,0,0,0.5) 145deg, transparent 175deg, transparent 235deg, rgba(0,0,0,0.55) 265deg, transparent 295deg);
    mix-blend-mode: multiply;
    mask-image: radial-gradient(circle at 50% 52%, black 10%, black 40%, transparent 58%);
    -webkit-mask-image: radial-gradient(circle at 50% 52%, black 10%, black 40%, transparent 58%);
  }
  .group:hover .doc-preview-green-starfield .doc-preview-accent {
    transform: rotate(20deg);
  }
  .doc-preview-green-starfield .doc-preview-stars {
    opacity: 0.95;
    z-index: 2;
  }
  .doc-preview-green-starfield::before,
  .doc-preview-green-starfield::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .doc-preview-green-starfield::before {
    background: radial-gradient(ellipse 75% 110% at 50% 52%, color-mix(in oklch, var(--c1) 70%, transparent) 0%, color-mix(in oklch, var(--c2) 55%, transparent) 18%, color-mix(in oklch, var(--c2) 28%, transparent) 40%, color-mix(in oklch, var(--c2) 12%, transparent) 65%, transparent 90%);
    filter: blur(18px);
    mix-blend-mode: screen;
    opacity: 0.85;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1), opacity 700ms ease;
  }
  .doc-preview-green-starfield::after {
    --ring-angle: 90deg;
    background: conic-gradient(from var(--ring-angle) at 50% 52%, transparent 0deg, color-mix(in oklch, var(--c1) 40%, transparent) 40deg, transparent 90deg, color-mix(in oklch, var(--c2) 35%, transparent) 150deg, transparent 200deg, color-mix(in oklch, var(--c1) 35%, transparent) 250deg, transparent 310deg, color-mix(in oklch, var(--c2) 40%, transparent) 350deg);
    mask-image: radial-gradient(ellipse 42% 78% at 50% 52%, transparent 60%, black 75%, black 88%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 42% 78% at 50% 52%, transparent 60%, black 75%, black 88%, transparent 100%);
    filter: blur(4px);
    mix-blend-mode: screen;
    opacity: 0.85;
    transition: --ring-angle 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .group:hover .doc-preview-green-starfield::before {
    transform: scale(1.06);
    opacity: 1;
  }
  .group:hover .doc-preview-green-starfield::after {
    --ring-angle: 78deg;
  }
  .doc-preview-green-starfield .doc-preview-vignette {
    z-index: 3;
  }

  .doc-preview-pulsar .doc-preview-base {
    background:
      radial-gradient(circle at 50% 50%, var(--c1) 0%, color-mix(in oklch, var(--c1) 60%, var(--c2)) 4%, transparent 14%),
      conic-gradient(from 60deg at 50% 50%, transparent 0deg, color-mix(in oklch, var(--c1) 35%, transparent) 20deg, transparent 40deg, transparent 200deg, color-mix(in oklch, var(--c1) 35%, transparent) 220deg, transparent 240deg, transparent 360deg),
      linear-gradient(180deg, var(--c3), color-mix(in oklch, var(--c3) 70%, var(--c2) 30%));
  }
  .doc-preview-pulsar .doc-preview-accent {
    background: radial-gradient(circle at 50% 50%, color-mix(in oklch, var(--c1) 80%, transparent) 0%, transparent 8%);
    mix-blend-mode: screen;
  }
  .group:hover .doc-preview-pulsar .doc-preview-accent {
    transform: scale(1.6);
    opacity: 0.6;
  }

  .doc-preview-binary-star .doc-preview-base {
    background:
      radial-gradient(circle at 35% 55%, var(--c1) 0%, color-mix(in oklch, var(--c1) 60%, transparent) 6%, transparent 18%),
      radial-gradient(circle at 62% 45%, var(--c2) 0%, color-mix(in oklch, var(--c2) 60%, transparent) 5%, transparent 16%),
      radial-gradient(ellipse 70% 18% at 48% 50%, color-mix(in oklch, var(--c1) 30%, transparent) 0%, transparent 70%),
      linear-gradient(135deg, var(--c3), color-mix(in oklch, var(--c3) 60%, var(--c1) 20%));
  }
  .doc-preview-binary-star .doc-preview-accent {
    background:
      radial-gradient(circle at 35% 55%, color-mix(in oklch, var(--c1) 50%, transparent) 0%, transparent 14%),
      radial-gradient(circle at 62% 45%, color-mix(in oklch, var(--c2) 50%, transparent) 0%, transparent 12%);
    mix-blend-mode: screen;
  }
  .group:hover .doc-preview-binary-star .doc-preview-accent {
    transform: scale(1.15);
  }

  .doc-preview-wormhole .doc-preview-base {
    background:
      radial-gradient(circle at 50% 50%, color-mix(in oklch, var(--c1) 90%, white) 0%, var(--c1) 4%, var(--c2) 18%, color-mix(in oklch, var(--c2) 50%, var(--c3)) 38%, var(--c3) 70%),
      conic-gradient(from 0deg at 50% 50%, transparent 0deg, color-mix(in oklch, var(--c1) 35%, transparent) 30deg, transparent 60deg, transparent 180deg, color-mix(in oklch, var(--c2) 40%, transparent) 210deg, transparent 240deg);
  }
  .doc-preview-wormhole .doc-preview-accent {
    background: conic-gradient(from 0deg at 50% 50%, transparent 0deg, color-mix(in oklch, var(--c1) 50%, transparent) 90deg, transparent 180deg, color-mix(in oklch, var(--c2) 50%, transparent) 270deg, transparent 360deg);
    mix-blend-mode: screen;
    opacity: 0.6;
  }
  .group:hover .doc-preview-wormhole .doc-preview-accent {
    transform: rotate(25deg) scale(1.1);
  }

  .docs-constellation {
    position: absolute;
    right: -40px;
    bottom: -20px;
    width: clamp(280px, 36vw, 520px);
    height: auto;
    opacity: 0.45;
    pointer-events: none;
    transform-origin: 50% 50%;
    animation:
      docs-drift 80s ease-in-out infinite,
      docs-tumble 55s linear infinite;
  }

  :where(.dark) .docs-constellation {
    opacity: 0.6;
  }

  @keyframes docs-drift {
    0% { translate: 0 0; }
    15% { translate: -9vw -22px; }
    32% { translate: -24vw 14px; }
    50% { translate: -38vw -8px; }
    63% { translate: -43vw 28px; }
    78% { translate: -28vw -16px; }
    92% { translate: -10vw 20px; }
    100% { translate: 0 0; }
  }

  @keyframes docs-tumble {
    0% { rotate: -6deg; }
    25% { rotate: 4deg; }
    50% { rotate: -3deg; }
    75% { rotate: 7deg; }
    100% { rotate: -6deg; }
  }

  @keyframes docs-aurora-drift {
    0% { translate: 0 0; }
    25% { translate: -10vw -2vw; }
    50% { translate: -22vw 1vw; }
    75% { translate: -14vw -1vw; }
    100% { translate: 0 0; }
  }

  .docs-starfield,
  .docs-sparkles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .doc-star {
    position: absolute;
    border-radius: 9999px;
    background: color-mix(in oklch, var(--color-brand-primary) 75%, transparent);
    opacity: var(--o, 0.6);
    box-shadow: 0 0 4px currentColor;
    animation: star-twinkle 3s ease-in-out infinite;
    will-change: opacity, transform;
  }

  :where(.dark) .doc-star {
    background: color-mix(in oklch, var(--color-brand-quaternary) 90%, transparent);
  }

  @keyframes star-twinkle {
    0%, 100% { opacity: calc(var(--o) * 0.35); transform: scale(0.85); }
    50% { opacity: var(--o); transform: scale(1.15); }
  }

  .doc-sparkle {
    position: absolute;
    color: color-mix(in oklch, var(--color-brand-tertiary) 80%, transparent);
    opacity: var(--o, 0.5);
    line-height: 1;
    will-change: transform;
    animation:
      sparkle-bob var(--bob-d, 8s) ease-in-out infinite var(--bob-delay, 0s),
      sparkle-spin var(--spin-d, 20s) linear infinite var(--spin-dir, normal);
  }

  :where(.dark) .doc-sparkle {
    color: color-mix(in oklch, var(--color-brand-tertiary) 95%, transparent);
  }

  @keyframes sparkle-bob {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(8px, -16px); }
  }

  @keyframes sparkle-spin {
    from { rotate: 0deg; }
    to { rotate: 360deg; }
  }

  @media (prefers-reduced-motion: reduce) {
    .docs-reveal,
    .docs-card-reveal {
      opacity: 1;
    }
    .doc-preview-layer,
    .doc-star,
    .doc-sparkle,
    .docs-constellation {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  import { animate, inView, stagger } from "motion";
  import { isMotionDisabled, MOTION_EVENT } from "@/lib/motion";

  function initDocsIndex() {
    if (!document.querySelector("main #main, main")) return;
    const reduce = isMotionDisabled();

    const intro = document.querySelectorAll<HTMLElement>(".docs-reveal");
    if (intro.length) {
      if (reduce) {
        for (const el of intro) el.style.opacity = "1";
      } else {
        animate(
          intro,
          { opacity: [0, 1], transform: ["translateY(18px)", "translateY(0)"] },
          { duration: 0.7, delay: stagger(0.08, { startDelay: 0.1 }), ease: [0.22, 1, 0.36, 1] },
        );
      }
    }

    const cards = document.querySelectorAll<HTMLElement>(".docs-card-reveal");
    for (const el of cards) {
      if (reduce) {
        el.style.opacity = "1";
        continue;
      }
      const delay = Number.parseInt((el.style.getPropertyValue("--reveal-delay") || "0").replace("ms", ""), 10) / 1000;
      inView(
        el,
        () => {
          animate(
            el,
            { opacity: [0, 1], transform: ["translateY(28px)", "translateY(0)"] },
            { duration: 0.7, delay, ease: [0.22, 1, 0.36, 1] },
          );
        },
        { amount: 0.15 },
      );
    }
  }

  initDocsIndex();
  document.addEventListener("astro:page-load", initDocsIndex);
  document.addEventListener(MOTION_EVENT, initDocsIndex);
</script>
