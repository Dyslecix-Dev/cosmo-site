---
import Charts from "@/components/sections/Charts.astro";
import Features from "@/components/sections/Features.astro";
import Hero from "@/components/sections/Hero.astro";
import Marquee from "@/components/sections/Marquee.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout description="Cosmo is the Astro launchpad you've been searching for. Tokens, MDX, content collections, sensible defaults.">
  <main id="main" class="overflow-x-clip">
    <Hero />
    <Marquee />
    <Features />
    <Charts />
  </main>
</BaseLayout>

<style is:global>
  .reveal-on-scroll {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-on-scroll {
      opacity: 1;
    }
  }
</style>

<script>
  import { animate, inView } from "motion";

  function initScrollReveals() {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const scrollEls = document.querySelectorAll<HTMLElement>(".reveal-on-scroll");
    for (const el of scrollEls) {
      if (reduce) {
        el.style.opacity = "1";
        continue;
      }
      const delay = Number.parseInt(el.style.getPropertyValue("--reveal-delay") || "0", 10) / 1000;
      inView(
        el,
        () => {
          animate(
            el,
            { opacity: [0, 1], transform: ["translateY(28px)", "translateY(0)"] },
            { duration: 0.7, delay, ease: [0.22, 1, 0.36, 1] },
          );
        },
        { amount: 0.2 },
      );
    }
  }

  initScrollReveals();
  document.addEventListener("astro:page-load", initScrollReveals);
</script>
